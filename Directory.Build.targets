<Project>
	<!-- Applies to direct and NuGet-transitive references alike, so every build of the local Contracts project shares the
	     same global properties (one output, no concurrent writes) and carries LocalCoreLibsVersion. -->
	<Target Name="StampLocalCoreLibsVersion"
	        AfterTargets="IncludeTransitiveProjectReferences"
	        BeforeTargets="AssignProjectConfiguration"
	        Condition="'$(LocalCoreLibsVersion)' != ''">
		<ItemGroup>
			<ProjectReference Condition="'%(Filename)' == 'GovUK.Dfe.CoreLibs.Contracts'">
				<AdditionalProperties>Version=$(LocalCoreLibsVersion)</AdditionalProperties>
			</ProjectReference>
		</ItemGroup>
	</Target>
</Project>
