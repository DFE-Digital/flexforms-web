{
  "name": "GovUK.Dfe.FlexForms.cypresstest",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "cypress.config.js",
  "scripts": {
    "cy:open": "cypress open --browser edge",
    "cy:run": "npm run clean:reports && cypress run --browser edge",
    "cy:ui": "cypress run --browser edge --spec 'cypress/e2e/**/*.cy.ts'",
    "clean:reports": "rm -rf cypress/reports/mocha/*.json",
    "combine:reports": "mochawesome-merge cypress/reports/mocha/*.json> mochareports/report.json",
    "create:html:report": "marge mochareports/report.json -f report -o mochareports",
    "generate:html:report": "npm run combine:reports && npm run create:html:report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cypress": "^15.8.1",
    "cypress-axe": "^1.7.0",
    "cypress-file-upload": "^5.0.8",
    "cypress-multi-reporters": "^2.0.4",
    "eslint": "^10.6.0",
    "eslint-plugin-cypress": "^6.4.2",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.15.0"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.7",
    "uuid": "^11.1.1"
  }
}
