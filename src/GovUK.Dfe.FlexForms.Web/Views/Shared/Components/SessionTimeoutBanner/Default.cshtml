@model GovUK.Dfe.FlexForms.Web.ViewComponents.SessionTimeoutViewModel
@if (Model.Enabled)
{
    <div id="app-timeout-overlay"
         class="app-timeout-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="timeout-title"
         hidden>
        <div class="app-timeout-dialog">
            <h2 id="timeout-title" class="govuk-heading-m">You're about to be signed out</h2>
            <p class="govuk-body">
                For your security, we will sign you out in
                <strong id="app-timeout-count">@Model.WarningWindowSeconds seconds</strong>
                due to inactivity.
            </p>

            <div class="app-timeout-progress">
                <div id="app-timeout-progress-bar" class="app-timeout-progress__bar"></div>
            </div>

            <form id="app-timeout-form" method="post" action="@Model.StaySignedInUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <button id="app-timeout-stay" class="govuk-button" data-module="govuk-button" type="submit">
                    Stay signed in
                </button>
                <button id="app-timeout-signout"
                        class="govuk-link govuk-!-margin-left-4"
                        formaction="@Model.ManualSignOutUrl"
                        formmethod="post"
                        type="submit"
                        style="background:none;border:none;padding:0;">
                    Sign out
                </button>
            </form>
        </div>
    </div>

    <style>
        .app-timeout-overlay[hidden] { display: none !important; }
        .app-timeout-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 9999; display: flex; align-items: center; justify-content: center; }
        .app-timeout-dialog { background: #fff; border: 4px solid #ffbf47; max-width: 520px; width: 90%; padding: 24px; box-shadow: 0 0 0 4px #0b0c0c; }
        .app-timeout-progress { height: 8px; background: #f3f2f1; margin: 12px 0 24px; overflow: hidden; }
        .app-timeout-progress__bar { height: 100%; background: #00703c; width: 100%; transform-origin: left center; }
    </style>

    <script>
        (function () {
            var inactivitySeconds = @Model.InactivityThresholdSeconds;
            var warningSeconds = @Model.WarningWindowSeconds;
            var stayUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaySignedInUrl));
            var timeoutSignOutUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TimeoutSignOutUrl));

            var warnAfterMs = Math.max(0, (inactivitySeconds - warningSeconds) * 1000);
            var warningMs = Math.max(1000, warningSeconds * 1000);

            var overlay = document.getElementById('app-timeout-overlay');
            var countEl = document.getElementById('app-timeout-count');
            var progressBar = document.getElementById('app-timeout-progress-bar');
            var form = document.getElementById('app-timeout-form');
            var stayBtn = document.getElementById('app-timeout-stay');
            if (!overlay || !form || !stayBtn) return;

            var warnTimer = null;
            var countdownTimer = null;
            var countdownInterval = null;
            var warningVisible = false;
            var signingOut = false;
            var activityEvents = ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click', 'wheel'];

            function format(seconds) {
                var s = Math.max(0, Math.floor(seconds));
                var m = Math.floor(s / 60);
                var r = s % 60;
                if (m <= 0) return r + (r === 1 ? ' second' : ' seconds');
                return m + ':' + (r < 10 ? '0' : '') + r;
            }

            function getAntiForgeryToken() {
                var input = form.querySelector('input[name="__RequestVerificationToken"]');
                return input ? input.value : '';
            }

            function clearTimers() {
                if (warnTimer) { clearTimeout(warnTimer); warnTimer = null; }
                if (countdownTimer) { clearTimeout(countdownTimer); countdownTimer = null; }
                if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
            }

            function hideWarning() {
                warningVisible = false;
                overlay.hidden = true;
                if (progressBar) {
                    progressBar.style.transition = 'none';
                    progressBar.style.width = '100%';
                }
            }

            function postTimeoutSignOut() {
                if (signingOut) return;
                signingOut = true;
                clearTimers();

                var token = getAntiForgeryToken();
                var logoutForm = document.createElement('form');
                logoutForm.method = 'post';
                logoutForm.action = timeoutSignOutUrl;
                logoutForm.style.display = 'none';

                var tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;
                logoutForm.appendChild(tokenInput);
                document.body.appendChild(logoutForm);
                logoutForm.submit();
            }

            function showWarning() {
                if (warningVisible || signingOut) return;
                warningVisible = true;
                overlay.hidden = false;

                var remaining = Math.ceil(warningMs / 1000);
                if (countEl) countEl.textContent = format(remaining);

                if (progressBar) {
                    progressBar.style.transition = 'none';
                    progressBar.style.width = '100%';
                    // Force reflow then animate to 0 over the warning window
                    void progressBar.offsetWidth;
                    progressBar.style.transition = 'width ' + (warningMs / 1000) + 's linear';
                    progressBar.style.width = '0%';
                }

                countdownInterval = setInterval(function () {
                    remaining -= 1;
                    if (countEl) countEl.textContent = format(remaining);
                    if (remaining <= 0 && countdownInterval) {
                        clearInterval(countdownInterval);
                        countdownInterval = null;
                    }
                }, 1000);

                countdownTimer = setTimeout(postTimeoutSignOut, warningMs);
            }

            function armTimers() {
                clearTimers();
                hideWarning();
                warnTimer = setTimeout(showWarning, warnAfterMs);
            }

            function onUserActivity() {
                // While the warning is visible the user must choose Stay signed in / Sign out.
                if (warningVisible || signingOut) return;
                armTimers();
            }

            activityEvents.forEach(function (evt) {
                document.addEventListener(evt, onUserActivity, { passive: true, capture: true });
            });

            stayBtn.addEventListener('click', function (e) {
                e.preventDefault();
                if (signingOut) return;

                stayBtn.disabled = true;
                clearTimers();

                var body = new URLSearchParams();
                body.set('__RequestVerificationToken', getAntiForgeryToken());
                var returnUrlInput = form.querySelector('input[name="returnUrl"]');
                if (returnUrlInput && returnUrlInput.value) {
                    body.set('returnUrl', returnUrlInput.value);
                }

                fetch(stayUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body.toString(),
                    credentials: 'same-origin'
                }).then(function (response) {
                    if (!response.ok) throw new Error('Stay signed in failed');
                    stayBtn.disabled = false;
                    armTimers();
                }).catch(function () {
                    // Fallback to full form post if fetch fails (e.g. auth expired)
                    stayBtn.disabled = false;
                    form.submit();
                });
            });

            // Initial arm
            armTimers();
        })();
    </script>
}
