@using GovUK.Dfe.FlexForms.Web.Utilities
@using Microsoft.AspNetCore.Html;
@model GovUK.Dfe.FlexForms.Web.Services.FieldViewModel
@{
	var validationAttributes = new HtmlString(Model.ValidationAttributes);
	var labelClasses = Model.Field.Label.IsVisible ? "govuk-label govuk-label--m" : "govuk-visually-hidden";
	var hasError = !string.IsNullOrEmpty(Model.ErrorMessage);
	var hintId = $"{Model.Id}-hint";
	var errorId = $"{Model.Id}-error";
	var (hintHtml, hintClass) = MarkdownSafe.RenderHintWithClass(Model.Field.Tooltip);
	var describedBy = hasError ? $"{hintId} {errorId}" : hintId;
}

<div class="govuk-form-group@(hasError ? " govuk-form-group--error" : "")">
	<label class="@labelClasses" for="@Model.Id">
		@Model.Field.Label.Value
	</label>
	<div id="@hintId" class="govuk-hint@(string.IsNullOrEmpty(hintClass) ? "" : $" {hintClass}")">@Html.Raw(hintHtml)</div>
	@if (hasError)
	{
		<h2 id="@errorId" class="govuk-error-message">
			<span class="govuk-visually-hidden">Error: </span>@Model.ErrorMessage
		</h2>
	}
	<input class="govuk-input@(hasError ? " govuk-input--error" : "")"
		   id="@Model.Id"
		   type="email"
		   name="Data[@Model.Field.FieldId]"
		   value="@Model.CurrentValue"
		   data-field-id="@Model.Field.FieldId"
		   aria-describedby="@describedBy"
		   @validationAttributes />
</div>
