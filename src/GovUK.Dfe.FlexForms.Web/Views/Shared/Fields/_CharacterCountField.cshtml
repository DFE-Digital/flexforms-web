@using Microsoft.AspNetCore.Html;
@using GovUK.Dfe.FlexForms.Web.Utilities;
@model GovUK.Dfe.FlexForms.Web.Services.FieldViewModel
@{
    var maxLengthValidation = Model.Field.Validations?.FirstOrDefault(v => v.Type == "maxLength");
    var maxWordsValidation = Model.Field.Validations?.FirstOrDefault(v => v.Type == "maxWords");

    var maxLengthRule = maxLengthValidation?.Rule.ToString();
    var maxWordsRule = maxWordsValidation?.Rule.ToString();

    int.TryParse(maxLengthRule, out var maxLengthValue);
    int.TryParse(maxWordsRule, out var maxWordsValue);

    var useWordLimit = maxWordsValue > 0;
    var limitAttributeValue = useWordLimit ? maxWordsValue : maxLengthValue;

    var labelClasses = Model.Field.Label.IsVisible ? "govuk-label govuk-label--m" : "govuk-visually-hidden";
    var (hintHtml, hintClass) = MarkdownSafe.RenderHintWithClass(Model.Field.Tooltip);
    var hasBlockHint = !string.IsNullOrEmpty(hintClass);

    var contentsViewData = new ViewDataDictionary(ViewData)
    {
        { "LabelClasses", labelClasses },
        { "HintHtml", hintHtml },
        { "HintClass", hintClass },
        { "HasBlockHint", hasBlockHint }
    };
}
@if (useWordLimit)
{
    <govuk-character-count id="@Model.Id" name="Data[@Model.Field.FieldId]" max-words="@limitAttributeValue">
        @await Html.PartialAsync("~/Views/Shared/Fields/_CharacterCountFieldContents.cshtml", Model, contentsViewData)
    </govuk-character-count>
}
else
{
    <govuk-character-count id="@Model.Id" name="Data[@Model.Field.FieldId]" max-length="@limitAttributeValue">
        @await Html.PartialAsync("~/Views/Shared/Fields/_CharacterCountFieldContents.cshtml", Model, contentsViewData)
    </govuk-character-count>
}
