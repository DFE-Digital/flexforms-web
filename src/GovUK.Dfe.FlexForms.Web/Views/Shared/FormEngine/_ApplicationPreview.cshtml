@model GovUK.Dfe.FlexForms.Web.Pages.FormEngine.RenderFormModel
@using GovUK.Dfe.FlexForms.Web.ViewModels.FormEngine
@{
    var preview = Model.Preview;
    var submit = preview?.Submit;
    var previewOptions = ApplicationPreviewOptions.Value;
    var pageHeading = FirstNonEmpty(previewOptions.PageHeading, "Check your answers");
    var submitHeading = FirstNonEmpty(previewOptions.SubmitHeading, $"Submit your {AppTerminology.Singular}");
    var submitHint = FirstNonEmpty(
        previewOptions.SubmitHint,
        $"By submitting this {AppTerminology.Singular} you are confirming that, to the best of your knowledge, the details you are providing are correct.");
    var submitButtonText = FirstNonEmpty(previewOptions.SubmitButtonText, "Submit");
    var showSubmitSection = submit?.ShowSubmitSection == true && !previewOptions.HideSubmitSection;
}

@if (submit?.SubmitDisabledByConfig == true)
{
    <div class="govuk-notification-banner" role="region" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Important</h2>
        </div>
        <div class="govuk-notification-banner__content">
            @submit.DisabledBannerText
            You can still work on your @AppTerminology.Singular and save it.
        </div>
    </div>
}

<div class="govuk-grid-row" data-application-preview="true">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">@pageHeading</h1>
        <govuk-inset-text>@AppTerminology.SingularCapitalised reference: <strong>@Model.ReferenceNumber</strong></govuk-inset-text>

        @if (!ViewData.ModelState.IsValid)
        {
            <govuk-error-summary>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <govuk-error-summary-item><span class="govuk-visually-hidden">Error: </span>@error.ErrorMessage</govuk-error-summary-item>
                }
            </govuk-error-summary>
        }

        @if (preview != null)
        {
            @foreach (var group in preview.Groups)
            {
                <h2 class="govuk-heading-m" id="group-@group.TestId" data-testid="group-@group.TestId">
                    @group.GroupName
                </h2>

                @foreach (var task in group.Tasks)
                {
                    <div class="govuk-summary-card govuk-!-margin-bottom-6" id="task-@task.TestId-summary">
                        <div class="govuk-summary-card__title-wrapper">
                            <h2 class="govuk-summary-card__title">@task.TaskName</h2>
                            @if (submit?.IsEditable == true)
                            {
                                <ul class="govuk-summary-card__actions">
                                    <li class="govuk-summary-card__action">
                                        <a class="govuk-link" href="@task.ChangeUrl" id="task-@task.TestId-change-link">
                                            Change<span class="govuk-visually-hidden"> @task.TaskName</span>
                                        </a>
                                    </li>
                                </ul>
                            }
                        </div>
                        <div class="govuk-summary-card__content">
                            <dl class="govuk-summary-list">
                                @foreach (var row in task.Rows)
                                {
                                    @await Html.PartialAsync("FormEngine/_SummaryRow", row)
                                }
                            </dl>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>

@if (showSubmitSection)
{
    <div class="govuk-!-margin-top-6">
        <h2 class="govuk-heading-m govuk-!-margin-top-9">@submitHeading</h2>

        @if (submit!.SubmitDisabledByConfig)
        {
            <p class="govuk-body">@submit.DisabledHelpText</p>
            <p class="govuk-body">You'll see a <b>@submitButtonText</b> button here when they're open.</p>
            <p class="govuk-body">You can still work on your @AppTerminology.Singular and save it.</p>
        }
        else if (submit.FileValidationBlocksSubmit)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">You cannot submit until uploaded files pass validation.</p>
                        <ul class="govuk-list govuk-error-summary__list">
                            @foreach (var file in submit.BlockingFiles)
                            {
                                <li>
                                    <span>@file.OriginalFileName</span>
                                    @if (!string.IsNullOrWhiteSpace(file.ValidationMessage))
                                    {
                                        <span> — @file.ValidationMessage</span>
                                    }
                                    else if (file.ValidationStatus == GovUK.Dfe.CoreLibs.Contracts.ExternalApplications.Enums.FileValidationStatus.Pending)
                                    {
                                        <span> — validation is still running</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <button class="govuk-button" type="button" disabled="disabled" aria-disabled="true" id="submit-application-button">
                @submitButtonText
            </button>
        }
        else
        {
            <p class="govuk-body">@submitHint</p>
            <form method="post" asp-page-handler="SubmitApplication">
                <input type="hidden" asp-for="ReferenceNumber"/>
                @if (submit.IncludePreviewQuery)
                {
                    <input type="hidden" name="preview" value="true"/>
                }
                <govuk-button type="submit" id="submit-application-button">
                    @submitButtonText
                </govuk-button>
            </form>
        }
    </div>
}
else if (submit?.ShowLeadApplicantInset == true && !previewOptions.HideSubmitSection)
{
    <div class="govuk-!-margin-top-6">
        <div class="govuk-inset-text">
            <p class="govuk-body">Only the lead applicant can submit this @AppTerminology.Singular.</p>
        </div>
    </div>
}

@functions {
    private static string FirstNonEmpty(string? configured, string fallback) =>
        string.IsNullOrWhiteSpace(configured) ? fallback : configured.Trim();
}
