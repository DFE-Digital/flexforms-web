@model GovUK.Dfe.FlexForms.Web.ViewModels.FormEngine.CollectionFlowSectionViewModel

<div class="govuk-!-margin-bottom-8">
    <h2 class="govuk-heading-m">@Model.Title</h2>

    @if (!string.IsNullOrEmpty(Model.DescriptionHtml))
    {
        <div class="govuk-body">@Html.Raw(Model.DescriptionHtml)</div>
    }

    @if (Model.Items.Count > 0)
    {
        @if (Model.IsListStyle)
        {
            <dl class="govuk-summary-list">
                @foreach (var item in Model.Items)
                {
                    @await Html.PartialAsync("FormEngine/_SummaryRow", item.HeaderRow)
                    @foreach (var row in item.Rows)
                    {
                        @await Html.PartialAsync("FormEngine/_SummaryRow", row)
                    }
                }
            </dl>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <div class="govuk-summary-card govuk-!-margin-bottom-6">
                    <div class="govuk-summary-card__title-wrapper">
                        <h3 class="govuk-summary-card__title">@item.Title</h3>
                        <ul class="govuk-summary-card__actions">
                            <li class="govuk-summary-card__action">
                                @await Html.PartialAsync("FormEngine/_CollectionItemRemove", item.Remove)
                            </li>
                        </ul>
                    </div>
                    <div class="govuk-summary-card__content">
                        <dl class="govuk-summary-list">
                            @foreach (var row in item.Rows)
                            {
                                @await Html.PartialAsync("FormEngine/_SummaryRow", row)
                            }
                        </dl>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="govuk-inset-text" id="@Model.NoItemsHintId">
            No @(Model.ItemKindPlural.ToLowerInvariant()) have been added.
        </div>
    }

    @if (Model.CanAddMore)
    {
        <div class="govuk-!-margin-bottom-4">
            <a class="govuk-button" id="@Model.AddButtonId" href="@Model.AddUrl">@Model.AddButtonLabel</a>
        </div>
    }
</div>
