<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>8051c984-585b-4a5e-b6d7-833e5dd4afe7</UserSecretsId>
		<Version>2.0.0</Version>
		<InformationalVersion>2.0.0</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..</DockerfileContext>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="GovUK.Dfe.CoreLibs.Contracts" Version="1.0.81" />
		<PackageReference Include="GovUK.Dfe.CoreLibs.Security" Version="1.1.28" />
		<PackageReference Include="GovUk.Frontend.AspNetCore" Version="4.3.0" />
		<PackageReference Include="HtmlSanitizer" Version="9.0.967" />
		<PackageReference Include="Markdig" Version="1.3.2" />
		<!-- 2.x required: HealthCheckTelemetryFilter uses ITelemetryProcessor (removed in Application Insights 3.x) -->
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GovUK.Dfe.FlexForms.Application\GovUK.Dfe.FlexForms.Application.csproj" />
		<ProjectReference Include="..\GovUK.Dfe.FlexForms.Infrastructure\GovUK.Dfe.FlexForms.Infrastructure.csproj" />
	</ItemGroup>

</Project>
