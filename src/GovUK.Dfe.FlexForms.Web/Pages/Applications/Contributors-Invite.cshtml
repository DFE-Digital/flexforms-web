@page "/applications/{referenceNumber}/contributors/invite"
@model ContributorsInviteModel
@{
    ViewData["Title"] = "Add a contributor";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">
            Add a contributor
        </h1>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" data-module="govuk-error-summary">
                <h2 class="govuk-error-summary__title" id="error-summary-title">
                    There is a problem
                </h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        @foreach (var error in ViewData.ModelState.Where(x => x.Value?.Errors.Any(e => !string.IsNullOrWhiteSpace(e.ErrorMessage)) == true))
                        {
                            foreach (var modelError in error.Value!.Errors.Where(e => !string.IsNullOrWhiteSpace(e.ErrorMessage)))
                            {
                                <li>
                                    <a href="#@error.Key"><span class="govuk-visually-hidden">Error: </span>@modelError.ErrorMessage</a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        }

        <form method="post" asp-page-handler="SendInvite" novalidate>
            <div class="govuk-form-group @(ViewData.ModelState.ContainsKey(nameof(Model.Name)) && ViewData.ModelState[nameof(Model.Name)]!.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                <label class="govuk-label govuk-label--m" for="Name">
                    Full name
                </label>
                @if (ViewData.ModelState.ContainsKey(nameof(Model.Name)) && ViewData.ModelState[nameof(Model.Name)]!.Errors.Count > 0)
                {
                    <p id="Name-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span>
                        <span asp-validation-for="Name"></span>
                    </p>
                }

                <input class="govuk-input @(ViewData.ModelState.ContainsKey(nameof(Model.Name)) && ViewData.ModelState[nameof(Model.Name)]!.Errors.Count > 0 ? "govuk-input--error" : "")" 
                       id="Name" 
                       name="Name" 
                       type="text" 
                       value="@Model.Name"
                       autocomplete="name">
            </div>

            <div class="govuk-form-group @(ViewData.ModelState.ContainsKey(nameof(Model.EmailAddress)) && ViewData.ModelState[nameof(Model.EmailAddress)]!.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                <label class="govuk-label govuk-label--m" for="EmailAddress">
                    Email address
                </label>
                <div id="EmailAddress-hint" class="govuk-hint">
                    This will only be used to invite them to contribute to the @DisplayCopy.Singular
                </div>
                
                @if (ViewData.ModelState.ContainsKey(nameof(Model.EmailAddress)) && ViewData.ModelState[nameof(Model.EmailAddress)]!.Errors.Count > 0)
                {
                    <p id="EmailAddress-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span>
                        <span asp-validation-for="EmailAddress"></span>
                    </p>
                }

                <input class="govuk-input @(ViewData.ModelState.ContainsKey(nameof(Model.EmailAddress)) && ViewData.ModelState[nameof(Model.EmailAddress)]!.Errors.Count > 0 ? "govuk-input--error" : "")" 
                       id="EmailAddress" 
                       name="EmailAddress" 
                       type="email" 
                       value="@Model.EmailAddress"
                       aria-describedby="EmailAddress-hint @(ViewData.ModelState.ContainsKey(nameof(Model.EmailAddress)) && ViewData.ModelState[nameof(Model.EmailAddress)]!.Errors.Count > 0 ? "EmailAddress-error" : "")">
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" aria-describedby="permissions-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        What can they do on this @DisplayCopy.Singular?
                    </legend>
                    <div id="permissions-hint" class="govuk-hint">
                        Choose what this person will be able to do on this @DisplayCopy.Singular.
                    </div>
                    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input"
                                   id="CanViewApplication"
                                   name="CanViewApplication"
                                   type="checkbox"
                                   value="true"
                                   checked
                                   disabled>
                            <label class="govuk-label govuk-checkboxes__label" for="CanViewApplication">
                                View this @DisplayCopy.Singular
                            </label>
                        </div>

                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input"
                                   asp-for="CanChangeApplication"
                                   id="CanChangeApplication">
                            <label class="govuk-label govuk-checkboxes__label" for="CanChangeApplication">
                                Change this @DisplayCopy.Singular
                            </label>
                        </div>

                        @if (Model.ShowFilePermissions)
                        {
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input"
                                       asp-for="CanViewUploadedFiles"
                                       id="CanViewUploadedFiles">
                                <label class="govuk-label govuk-checkboxes__label" for="CanViewUploadedFiles">
                                    View uploaded files
                                </label>
                            </div>

                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input"
                                       asp-for="CanUploadFiles"
                                       id="CanUploadFiles">
                                <label class="govuk-label govuk-checkboxes__label" for="CanUploadFiles">
                                    Upload files
                                </label>
                            </div>

                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input"
                                       asp-for="CanDeleteUploadedFiles"
                                       id="CanDeleteUploadedFiles">
                                <label class="govuk-label govuk-checkboxes__label" for="CanDeleteUploadedFiles">
                                    Delete uploaded files
                                </label>
                            </div>
                        }
                    </div>
                </fieldset>
            </div>

            <div class="govuk-button-group">
                <button id="send-email-invite" class="govuk-button" data-module="govuk-button" type="submit">
                    Send email invite
                </button>

                <button class="govuk-button govuk-button--secondary"
                id="cancel"
                        data-module="govuk-button" 
                        type="submit" 
                        asp-page-handler="Cancel"
                        formnovalidate>
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>
