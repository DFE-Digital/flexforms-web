@page "/application-submitted/{referenceNumber}"
@model ApplicationSubmittedModel
@{
    ViewData["Title"] = Model.PanelTitle;
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-panel govuk-panel--confirmation">
            <h1 class="govuk-panel__title">@Model.PanelTitle</h1>
            <div class="govuk-panel__body">
                Your reference number<br>
                <strong>@Model.ReferenceNumber</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.BodyHtml))
        {
            <div class="application-submitted-body">
                @Html.Raw(Model.BodyHtml)
            </div>
        }
    </div>
</div>
