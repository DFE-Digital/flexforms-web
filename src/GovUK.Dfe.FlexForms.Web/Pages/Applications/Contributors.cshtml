@page "/applications/{referenceNumber}/contributors"
@using GovUK.Dfe.FlexForms.Application.Contributors
@using GovUK.Dfe.FlexForms.Web.Extensions
@model ContributorsModel

@{
    ViewData["Title"] = DisplayCopy.ContributorsPageHeading;

    var applicationId = HttpContext.Session.GetString("ApplicationId");
    var leadApplicantName = HttpContext.Session.GetString($"ApplicationLeadApplicantName_{applicationId}");
    var leadApplicantEmail = HttpContext.Session.GetString($"ApplicationLeadApplicantEmail_{applicationId}");
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">
            @DisplayCopy.ContributorsPageHeading
        </h1>

        @if (Model.HasError)
        {
            <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" data-module="govuk-error-summary">
                <h2 class="govuk-error-summary__title" id="error-summary-title">
                    There is a problem
                </h2>
                <div class="govuk-error-summary__body">
                    <span class="govuk-visually-hidden">Error: </span>
                    <p>@Model.ErrorMessage</p>
                </div>
            </div>
        }

        <p class="govuk-body">
            @DisplayCopy.ContributorsIntro
        </p>

        <p class="govuk-body">
            @DisplayCopy.ContributorsSignInText
        </p>

        <p class="govuk-body">
            @DisplayCopy.ContributorsOnceJoinedText
        </p>

        <p class="govuk-body">
            @DisplayCopy.ContributorsAddLaterText
        </p>

        <div class="govuk-button-group">
            <form method="post">
                <button id="add-a-contributor" class="govuk-button" type="submit" asp-page-handler="AddContributor" data-module="govuk-button">
                    @DisplayCopy.ContributorsAddButtonText
                </button>
            </form>

            <form method="post">
                <button id="proceed-to-application-form" class="govuk-button govuk-button--secondary" type="submit" asp-page-handler="ProceedToForm" data-module="govuk-button">
                    @DisplayCopy.ContributorsProceedButtonText
                </button>
            </form>
        </div>

        <h2 class="govuk-heading-l govuk-!-margin-top-9">
            @DisplayCopy.ContributorsCurrentHeading
        </h2>

        <div class="govuk-summary-card" id="contributor-1">
            <div class="govuk-summary-card__title-wrapper">
                <h3 class="govuk-summary-card__title">@(string.IsNullOrWhiteSpace(leadApplicantName) ? "Lead applicant" : leadApplicantName)</h3>
            </div>
            <div class="govuk-summary-card__content">
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Email address</dt>
                        <dd class="govuk-summary-list__value">@leadApplicantEmail</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Role</dt>
                        <dd class="govuk-summary-list__value">Lead applicant</dd>
                    </div>
                </dl>
            </div>
        </div>

        @foreach (var (contributor, index) in Model.Contributors.Select((contributor, index) => (contributor, index)))
        {
            var contributorIndex = index + 2; // zero-based, so +2 keeps the lead applicant as contributor-1
            var permissionLabels = Model.ApplicationId.HasValue
                ? ContributorAccessLabels.ForApplication(contributor, Model.ApplicationId.Value, DisplayCopy.Singular)
                : Array.Empty<string>();

            <div class="govuk-summary-card" id="contributor-@contributorIndex">
                <div class="govuk-summary-card__title-wrapper">
                    <h3 class="govuk-summary-card__title">@contributor.Name</h3>
                    <ul class="govuk-summary-card__actions">
                        <li class="govuk-summary-card__action">
                            <form method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contributorId" value="@contributor.UserId" />
                                <input type="hidden" name="contributorEmail" value="@contributor.Email" />
                                <input type="hidden" name="contributorName" value="@contributor.Name" />
                                @Html.RenderWarningConfirmationButton(
                                    buttonText: "Remove",
                                    handler: "RemoveContributor",
                                    displayFields: "contributorEmail,contributorName",
                                    title: "Are you sure you want to remove this contributor?",
                                    requiredMessage: $"Select yes if you are sure you want to remove this contributor",
                                    buttonId: $"remove-contributor-{contributorIndex}")
                            </form>
                        </li>
                    </ul>
                </div>
                <div class="govuk-summary-card__content">
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Email address</dt>
                            <dd class="govuk-summary-list__value">@contributor.Email</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Permissions</dt>
                            <dd class="govuk-summary-list__value">
                                @if (permissionLabels.Count == 0)
                                {
                                    <span>No permissions listed</span>
                                }
                                else
                                {
                                    <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
                                        @foreach (var label in permissionLabels)
                                        {
                                            <li>@label</li>
                                        }
                                    </ul>
                                }
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
        }
    </div>
</div>