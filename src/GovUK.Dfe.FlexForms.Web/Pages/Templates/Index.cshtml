@page "/templates"
@model GovUK.Dfe.FlexForms.Web.Pages.Templates.IndexModel
@{
    ViewData["Title"] = "Choose a form";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Choose a form</h1>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">@Model.ErrorMessage</p>
                    </div>
                </div>
            </div>
        }

        @if (Model.Templates.Count == 0)
        {
            <p class="govuk-body">
                There are no forms available for you yet.
                @if (Model.IsAdmin)
                {
                    <text>Create a form and set it to live when you are ready for users.</text>
                }
                else
                {
                    <text>If you think this is wrong, contact your administrator.</text>
                }
            </p>
            @if (Model.IsAdmin)
            {
                <p class="govuk-body">
                    <a class="govuk-link" href="/admin">Go to admin</a>
                </p>
            }
        }
        else
        {
            <form method="post" asp-page-handler="Select">
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="LiveOnly" />

                <div class="govuk-form-group @(string.IsNullOrEmpty(Model.ErrorMessage) ? "" : "govuk-form-group--error")">
                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                            Select the form you want to work with
                        </legend>
                        @if (Model.IsAdmin && !Model.LiveOnly)
                        {
                            <div class="govuk-hint">
                                Non-live forms are available to you for preview before going live.
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <p class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span> @Model.ErrorMessage
                            </p>
                        }
                        <div class="govuk-radios" data-module="govuk-radios">
                            @foreach (var template in Model.Templates)
                            {
                                var inputId = $"form-{template.TemplateId}";
                                var isChecked = Model.SelectedTemplateId == template.TemplateId;
                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input"
                                           id="@inputId"
                                           name="SelectedTemplateId"
                                           type="radio"
                                           value="@template.TemplateId"
                                           @(isChecked ? "checked" : null) />
                                    <label class="govuk-label govuk-radios__label" for="@inputId">
                                        @template.Name
                                        @if (Model.IsAdmin)
                                        {
                                            <text> (@(template.IsLive ? "Live" : "Not live"))</text>
                                        }
                                    </label>
                                    @if (!string.IsNullOrWhiteSpace(template.LatestVersionNumber))
                                    {
                                        <div class="govuk-hint govuk-radios__hint">
                                            Version @template.LatestVersionNumber
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </fieldset>
                </div>

                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Go to dashboard
                </button>
            </form>
        }
    </div>
</div>
