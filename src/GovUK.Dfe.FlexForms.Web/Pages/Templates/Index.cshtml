@page "/templates"
@model GovUK.Dfe.FlexForms.Web.Pages.Templates.IndexModel
@{
    ViewData["Title"] = "Choose a template";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Choose a template</h1>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">@Model.ErrorMessage</p>
                    </div>
                </div>
            </div>
        }

        @if (Model.Templates.Count == 0)
        {
            <p class="govuk-body">
                There are no templates available for you yet.
                @if (Model.IsAdmin)
                {
                    <text>Create a template and set it to live when you are ready for users.</text>
                }
                else
                {
                    <text>If you think this is wrong, contact your administrator.</text>
                }
            </p>
            @if (Model.IsAdmin)
            {
                <p class="govuk-body">
                    <a class="govuk-link" href="/admin">Go to admin</a>
                </p>
            }
        }
        else
        {
            <p class="govuk-body">
                Select the application template you want to work with.
                @if (Model.IsAdmin && !Model.LiveOnly)
                {
                    <text>Non-live templates are available to you for preview before going live.</text>
                }
            </p>

            <div class="govuk-grid-row">
                @foreach (var template in Model.Templates)
                {
                    <div class="govuk-grid-column-full govuk-!-margin-bottom-4">
                        <div class="govuk-summary-card">
                            <div class="govuk-summary-card__title-wrapper">
                                <h2 class="govuk-summary-card__title">@template.Name</h2>
                                @if (Model.IsAdmin)
                                {
                                    <ul class="govuk-summary-card__actions">
                                        <li class="govuk-summary-card__action">
                                            @if (template.IsLive)
                                            {
                                                <strong class="govuk-tag govuk-tag--green">Live</strong>
                                            }
                                            else
                                            {
                                                <strong class="govuk-tag govuk-tag--grey">Not live</strong>
                                            }
                                        </li>
                                    </ul>
                                }
                            </div>
                            <div class="govuk-summary-card__content">
                                <dl class="govuk-summary-list">
                                    @if (!string.IsNullOrWhiteSpace(template.LatestVersionNumber))
                                    {
                                        <div class="govuk-summary-list__row">
                                            <dt class="govuk-summary-list__key">Version</dt>
                                            <dd class="govuk-summary-list__value">@template.LatestVersionNumber</dd>
                                        </div>
                                    }
                                </dl>
                                <form method="post" asp-page-handler="Select">
                                    <input type="hidden" name="templateId" value="@template.TemplateId" />
                                    <input type="hidden" asp-for="ReturnUrl" />
                                    <input type="hidden" asp-for="LiveOnly" />
                                    <button type="submit" class="govuk-button govuk-!-margin-bottom-0">
                                        @(template.IsLive ? "Open dashboard" : "Preview dashboard")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
