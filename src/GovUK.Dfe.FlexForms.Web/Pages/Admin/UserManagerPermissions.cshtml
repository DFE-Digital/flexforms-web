@page "/admin/user-manager/permissions"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.UserManagerPermissionsModel
@{
    ViewData["Title"] = $"Permissions – {Model.UserName}";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <a asp-page="/Admin/UserManager" class="govuk-back-link">Back to User Manager</a>

        <govuk-error-summary>
            @foreach (var modelError in ViewData.ModelState.Where(item => item.Value?.Errors.Count > 0))
            {
                foreach (var error in modelError.Value!.Errors)
                {
                    <govuk-error-summary-item href="#">@error.ErrorMessage</govuk-error-summary-item>
                }
            }
        </govuk-error-summary>

        <h1 class="govuk-heading-xl">Manage permissions</h1>
        <p class="govuk-body">
            Add user-level permissions for <strong>@Model.UserName</strong>
            (<span class="govuk-!-font-size-16">@Model.UserEmail</span>).
            Each grant is a resource type, resource key, and access type.
            These override or supplement permissions inherited from the user's role.
            Manage access must be assigned via a tenant role, not to an individual user.
        </p>
        <p class="govuk-hint">
            Use a specific resource id (application GUID, template GUID, or user email) where needed.
            Special keys:
            <code class="govuk-!-font-size-16">Any</code> is allowed for
            <strong>Application — Read</strong>, <strong>ApplicationFiles — Read</strong>
            (CaseReader-style tenant-wide read), <strong>FileValidation — Write</strong>
            (tenant function callback), and <strong>Template — Write</strong>
            (create applications on any template).
            Manage is not available here — use Role Manager instead.
        </p>

        <form method="post" asp-page-handler="Add">
            <input type="hidden" asp-for="UserId" />
            @foreach (var grant in Model.SelectedGrants)
            {
                <input type="hidden" name="SelectedGrants" value="@grant" />
            }

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Add a permission
                    </legend>

                    <div class="govuk-form-group">
                        <label class="govuk-label" asp-for="NewResourceType">Resource type</label>
                        <select class="govuk-select" asp-for="NewResourceType">
                            @foreach (var resourceType in Model.ResourceTypes)
                            {
                                <option value="@resourceType">@resourceType</option>
                            }
                        </select>
                    </div>

                    <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.NewResourceKey)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                        <label class="govuk-label" asp-for="NewResourceKey">Resource key</label>
                        <div class="govuk-hint">
                            Application or ApplicationFiles: application id, or <code class="govuk-!-font-size-16">Any</code> with Read.
                            FileValidation: template id, or <code class="govuk-!-font-size-16">Any</code> with Write (integration callback).
                            Template: template id, or <code class="govuk-!-font-size-16">Any</code> with Write (create apps).
                            User or Notifications: user email.
                            Manage is not available for individual users — assign it via a tenant role.
                        </div>
                        @if (ViewData.ModelState[nameof(Model.NewResourceKey)]?.Errors.FirstOrDefault() is { } keyError)
                        {
                            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @keyError.ErrorMessage</p>
                        }
                        <input class="govuk-input" asp-for="NewResourceKey" autocomplete="off" spellcheck="false" />
                    </div>

                    <div class="govuk-form-group">
                        <label class="govuk-label" asp-for="NewAccessType">Access type</label>
                        <select class="govuk-select" asp-for="NewAccessType">
                            @foreach (var accessType in Model.AccessTypes)
                            {
                                <option value="@accessType">@accessType</option>
                            }
                        </select>
                    </div>

                    <button type="submit"
                            class="govuk-button govuk-button--secondary"
                            data-module="govuk-button">
                        Add
                    </button>
                </fieldset>
            </div>
        </form>

        <h2 class="govuk-heading-m">Permissions for this user</h2>

        @if (Model.SelectedGrants.Count == 0)
        {
            <p class="govuk-body">No user-level permissions added yet.</p>
        }
        else
        {
            <table class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Resource type</th>
                        <th scope="col" class="govuk-table__header">Resource key</th>
                        <th scope="col" class="govuk-table__header">Access</th>
                        <th scope="col" class="govuk-table__header">
                            <span class="govuk-visually-hidden">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var grant in Model.SelectedGrants)
                    {
                        var parts = grant.Split('|', 3);
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@(parts.Length > 0 ? parts[0] : grant)</td>
                            <td class="govuk-table__cell"><code class="govuk-!-font-size-16">@(parts.Length > 1 ? parts[1] : "")</code></td>
                            <td class="govuk-table__cell">@(parts.Length > 2 ? parts[2] : "")</td>
                            <td class="govuk-table__cell">
                                <form method="post" asp-page-handler="Remove" style="display:inline">
                                    <input type="hidden" asp-for="UserId" />
                                    @foreach (var g in Model.SelectedGrants)
                                    {
                                        <input type="hidden" name="SelectedGrants" value="@g" />
                                    }
                                    <button type="submit"
                                            class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                                            name="grantKey"
                                            value="@grant"
                                            data-module="govuk-button">
                                        Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="govuk-button-group">
            <a asp-page="/Admin/UserManager" class="govuk-link">Back to User Manager</a>
        </div>
    </div>
</div>
