@page "/admin/contributor-management"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.ContributorManagementModel
@{
    ViewData["Title"] = "Contributor management";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <a asp-page="/Admin/Admin" class="govuk-back-link">Back to Admin</a>

        <h1 class="govuk-heading-xl">Contributor management</h1>
        <p class="govuk-body">
            Look up who currently has access to an application, or look up a user by email to see the applications they created and who they invited.
        </p>
        <div class="govuk-inset-text">
            Application owners manage invite and remove from the application task list.
            Use this page to find who currently has access, then open the full contributors page if needed.
        </div>

        @if (Model.HasError)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">@Model.ErrorMessage</p>
                    </div>
                </div>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @foreach (var modelError in ViewData.ModelState.Where(item => item.Value?.Errors.Count > 0))
                            {
                                foreach (var error in modelError.Value!.Errors)
                                {
                                    <li><a href="#@modelError.Key">@error.ErrorMessage</a></li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <form method="post" novalidate>
        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">Find an application</h2>
            </div>
            <div class="govuk-summary-card__content">
                    <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.ReferenceNumber)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                        <label class="govuk-label govuk-label--m" asp-for="ReferenceNumber">Application reference number</label>
                        <div class="govuk-hint">Enter the full reference shown on the application</div>
                        @if (ViewData.ModelState[nameof(Model.ReferenceNumber)]?.Errors.FirstOrDefault() is { } refError)
                        {
                            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @refError.ErrorMessage</p>
                        }
                        <input class="govuk-input govuk-!-width-one-half @(ViewData.ModelState[nameof(Model.ReferenceNumber)]?.Errors.Any() == true ? "govuk-input--error" : "")"
                               asp-for="ReferenceNumber" id="ReferenceNumber" autocomplete="off" />
                    </div>
                    <button type="submit" class="govuk-button" data-module="govuk-button" asp-page-handler="LookupByReference">Look up contributors</button>
            </div>
        </div>

        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">Find a user</h2>
            </div>
            <div class="govuk-summary-card__content">
                    <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.Email)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                        <label class="govuk-label govuk-label--m" asp-for="Email">Email address</label>
                        <div class="govuk-hint">Enter the email of the person whose applications and invites you want to see</div>
                        @if (ViewData.ModelState[nameof(Model.Email)]?.Errors.FirstOrDefault() is { } emailError)
                        {
                            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @emailError.ErrorMessage</p>
                        }
                        <input class="govuk-input govuk-!-width-one-half @(ViewData.ModelState[nameof(Model.Email)]?.Errors.Any() == true ? "govuk-input--error" : "")"
                               asp-for="Email" id="Email" type="email" autocomplete="off" />
                    </div>
                    <button type="submit" class="govuk-button" data-module="govuk-button" asp-page-handler="LookupByEmail">Look up applications and invites</button>
            </div>
        </div>
        </form>

        @if (Model.LookupPerformed && !Model.HasError)
        {
            <h2 class="govuk-heading-l">Contributors</h2>
            <p class="govuk-body">
                Reference <strong>@Model.ApplicationReference</strong>
                @if (!string.IsNullOrWhiteSpace(Model.TemplateName))
                {
                    <text> · @Model.TemplateName</text>
                }
            </p>

            @if (Model.Contributors.Count == 0)
            {
                <p class="govuk-body">No contributors found for this application.</p>
            }
            else
            {
                <table class="govuk-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">Name</th>
                            <th scope="col" class="govuk-table__header">Email</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @foreach (var contributor in Model.Contributors)
                        {
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">
                                    @(string.IsNullOrWhiteSpace(contributor.Name) ? "—" : contributor.Name)
                                </td>
                                <td class="govuk-table__cell">
                                    <a class="govuk-link" href="mailto:@contributor.Email">@contributor.Email</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <p class="govuk-body">
                <a class="govuk-link" href="/applications/@Uri.EscapeDataString(Model.ApplicationReference!)/contributors">
                    Open full invite and remove UI
                </a>
            </p>
        }

        @if (Model.EmailLookupPerformed && !Model.HasError)
        {
            <h2 class="govuk-heading-l">Applications created by this user</h2>
            <p class="govuk-body">
                <strong>@(string.IsNullOrWhiteSpace(Model.LookedUpUserName) ? Model.LookedUpUserEmail : Model.LookedUpUserName)</strong>
                · @Model.LookedUpUserEmail
                · User ID <code>@Model.LookedUpUserId</code>
            </p>

            @if (Model.CreatedApplications.Count == 0)
            {
                <p class="govuk-body">This user has not created any applications.</p>
            }
            else
            {
                @foreach (var application in Model.CreatedApplications)
                {
                    <div class="govuk-summary-card">
                        <div class="govuk-summary-card__title-wrapper">
                            <h3 class="govuk-summary-card__title">
                                @application.ApplicationReference
                                @if (!string.IsNullOrWhiteSpace(application.TemplateName))
                                {
                                    <text> · @application.TemplateName</text>
                                }
                            </h3>
                        </div>
                        <div class="govuk-summary-card__content">
                            @if (application.Invitees.Count == 0)
                            {
                                <p class="govuk-body">No contributors have been invited to this application.</p>
                            }
                            else
                            {
                                <table class="govuk-table">
                                    <caption class="govuk-table__caption govuk-table__caption--m">People invited</caption>
                                    <thead class="govuk-table__head">
                                        <tr class="govuk-table__row">
                                            <th scope="col" class="govuk-table__header">Name</th>
                                            <th scope="col" class="govuk-table__header">Email</th>
                                            <th scope="col" class="govuk-table__header">User ID</th>
                                        </tr>
                                    </thead>
                                    <tbody class="govuk-table__body">
                                        @foreach (var invitee in application.Invitees)
                                        {
                                            <tr class="govuk-table__row">
                                                <td class="govuk-table__cell">
                                                    @(string.IsNullOrWhiteSpace(invitee.Name) ? "—" : invitee.Name)
                                                </td>
                                                <td class="govuk-table__cell">
                                                    <a class="govuk-link" href="mailto:@invitee.Email">@invitee.Email</a>
                                                </td>
                                                <td class="govuk-table__cell">
                                                    <code>@invitee.UserId</code>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            <p class="govuk-body">
                                <a class="govuk-link" href="/applications/@Uri.EscapeDataString(application.ApplicationReference)/contributors">
                                    Open full invite and remove UI
                                </a>
                            </p>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>
