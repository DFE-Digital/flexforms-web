@page "/admin"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.AdminModel
@{
    ViewData["Title"] = "Admin";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl">Admin</h1>

        @if (Model.HasError)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body"><span class="govuk-visually-hidden">Error: </span>@Model.ErrorMessage</p>
                    </div>
                </div>
            </div>
        }

        @if (Model.ShowSuccess)
        {
            <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" data-module="govuk-notification-banner">
                <div class="govuk-notification-banner__header">
                    <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
                </div>
                <div class="govuk-notification-banner__content">
                    <p class="govuk-notification-banner__heading">@Model.SuccessMessage</p>
                </div>
            </div>
        }

        @if (Model.CanManageTemplates)
        {
            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">Tenant templates</h2>
                </div>
                <div class="govuk-summary-card__content">
                    <p class="govuk-body">
                        Set which templates are live for end users. You can open non-live templates to preview them before going live.
                    </p>
                    @if (Model.TenantTemplates.Count == 0)
                    {
                        <p class="govuk-body">No templates found in this tenant.</p>
                    }
                    else
                    {
                        <table class="govuk-table">
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th scope="col" class="govuk-table__header">Name</th>
                                    <th scope="col" class="govuk-table__header">Status</th>
                                    <th scope="col" class="govuk-table__header">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                @foreach (var template in Model.TenantTemplates)
                                {
                                    <tr class="govuk-table__row">
                                        <td class="govuk-table__cell">
                                            @template.Name
                                            @if (!string.IsNullOrWhiteSpace(template.LatestVersionNumber))
                                            {
                                                <br />
                                                <span class="govuk-hint govuk-!-margin-bottom-0">Version @template.LatestVersionNumber</span>
                                            }
                                        </td>
                                        <td class="govuk-table__cell">
                                            @if (template.IsLive)
                                            {
                                                <strong class="govuk-tag govuk-tag--green">Live</strong>
                                            }
                                            else
                                            {
                                                <strong class="govuk-tag govuk-tag--grey">Not live</strong>
                                            }
                                        </td>
                                        <td class="govuk-table__cell">
                                            <div class="govuk-button-group">
                                                <form method="post" asp-page-handler="OpenTemplate" style="display: inline;">
                                                    <input type="hidden" name="templateId" value="@template.TemplateId" />
                                                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">
                                                        @(template.IsLive ? "Open" : "Preview")
                                                    </button>
                                                </form>
                                                @if (template.IsLive)
                                                {
                                                    <form method="post" asp-page-handler="MakeNotLive" style="display: inline;">
                                                        <input type="hidden" name="templateId" value="@template.TemplateId" />
                                                        <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0">
                                                            Make not live
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form method="post" asp-page-handler="MakeLive" style="display: inline;">
                                                        <input type="hidden" name="templateId" value="@template.TemplateId" />
                                                        <button type="submit" class="govuk-button govuk-!-margin-bottom-0">
                                                            Make live
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

        }

        @if (Model.CanManageTemplates)
        {
            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">Template Management</h2>
                </div>
                <div class="govuk-summary-card__content">
                    <p class="govuk-body">Create, edit and publish form templates for this tenant.</p>
                    <div class="govuk-button-group">
                        <a asp-page="/Admin/CreateTemplate" class="govuk-button" data-module="govuk-button" id="create-template-button">
                            Create a new template
                        </a>
                        <a asp-page="/Admin/TemplateManager" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="go-to-template-manager-button">
                            Template Manager
                        </a>
                        <a href="/templates" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="go-to-templates-button">
                            Choose / preview templates
                        </a>
                        <a asp-page="/Admin/CustomStatusLabelOverrides" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="go-to-custom-status-button">
                            Custom Status Labels
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.CanManageUsers || Model.CanManageRoles || Model.IsFullAdmin)
        {
            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">Users &amp; Roles</h2>
                </div>
                <div class="govuk-summary-card__content">
                    <p class="govuk-body">Manage user access, roles and permissions for this tenant.</p>
                    <div class="govuk-button-group">
                        @if (Model.CanManageUsers)
                        {
                            <a asp-page="/Admin/UserManager" class="govuk-button" data-module="govuk-button" id="go-to-user-manager-button">
                                User Manager
                            </a>
                        }
                        @if (Model.CanManageRoles)
                        {
                            <a asp-page="/Admin/RoleManager" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="go-to-role-manager-button">
                                Role Manager
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.IsFullAdmin)
        {
            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">Applications</h2>
                </div>
                <div class="govuk-summary-card__content">
                    <p class="govuk-body">Browse all applications for a template in this tenant.</p>
                    <div class="govuk-button-group">
                        <a asp-page="/Admin/Applications" class="govuk-button" data-module="govuk-button" id="go-to-admin-applications-button">
                            View applications
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.CanAccessTenantAdminSection)
        {
            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">Tenant Admin</h2>
                </div>
                <div class="govuk-summary-card__content">
                    <p class="govuk-body">
                        Manage this tenant’s organisation settings, event mappings, and configuration.
                        Changes apply to the current tenant only.
                    </p>
                    <div class="govuk-button-group">
                        @if (Model.CanManageOrganisationSettings)
                        {
                            <a asp-page="/Admin/OrganisationSettings" class="govuk-button" data-module="govuk-button" id="go-to-organisation-settings-button">
                                Organisation settings
                            </a>
                        }
                        @if (Model.CanManageEventMappings)
                        {
                            <a asp-page="/Admin/EventMappings" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="go-to-event-mappings-button">
                                Event mappings
                            </a>
                        }
                        @if (Model.CanManageTenantSettings)
                        {

                            <a asp-page="/Admin/TenantSettings" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="go-to-tenant-settings-button">
                                Tenant Settings
                            </a>
                        }
                        @if (Model.IsSuperAdmin)
                        {
            <a asp-page="/Admin/DuplicateTenant" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="go-to-duplicate-tenant-button">
                                New tenant
                            </a>
                            <a asp-page="/Admin/PlatformTenants" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="go-to-platform-tenants-button">
                                Platform tenants
                            </a>
                        }
                    </div>

                    @if (Model.CanViewTenantConfigurationSummary && Model.TenantConfigurationSummary is not null)
                    {
                        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
                        <h3 class="govuk-heading-s">This tenant’s configuration</h3>
                        <p class="govuk-body">Read-only summary of runtime configuration for the current tenant.</p>
                        <dl class="govuk-summary-list govuk-summary-list--no-border">
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">Auth scheme</dt>
                                <dd class="govuk-summary-list__value">
                                    <strong class="govuk-tag govuk-tag--blue">
                                        @(Model.TenantConfigurationSummary.InteractiveAuthScheme ?? "Not set")
                                    </strong>
                                </dd>
                            </div>
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">Auth providers</dt>
                                <dd class="govuk-summary-list__value">
                                    @(Model.TenantConfigurationSummary.TestAuthenticationEnabled ? "TestAuth " : "")
                                    @(Model.TenantConfigurationSummary.EntraSsoEnabled ? "EntraSSO " : "")
                                    @(Model.TenantConfigurationSummary.DfESignInConfigured ? "DfESignIn" : "")
                                </dd>
                            </div>
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">Hostnames</dt>
                                <dd class="govuk-summary-list__value">
                                    @if (Model.TenantConfigurationSummary.Hostnames?.Count > 0)
                                    {
                                        @string.Join(", ", Model.TenantConfigurationSummary.Hostnames)
                                    }
                                    else
                                    {
                                        <span class="govuk-hint">None</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    }
                </div>
            </div>
        }

        @if (Model.CanManageTemplates)
        {
            <div class="govuk-summary-card">
                <div class="govuk-summary-card__title-wrapper">
                    <h2 class="govuk-summary-card__title">System</h2>
                </div>
                <div class="govuk-summary-card__content">
                    <p class="govuk-body">Clear cached data and session state. You may need to re-select a template afterwards.</p>
                    <div class="govuk-button-group">
                        <form method="post" asp-page-handler="ClearAll" style="display: inline;">
                            <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button" id="clear-all-sessions-button">
                                Clear All Sessions &amp; Caches
                            </button>
                        </form>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.TemplateId))
                    {
                        <details class="govuk-details govuk-!-margin-top-4" data-module="govuk-details">
                            <summary class="govuk-details__summary">
                                <span class="govuk-details__summary-text">Diagnostics</span>
                            </summary>
                            <div class="govuk-details__text">
                                <h3 class="govuk-heading-s">Active Template</h3>
                                <dl class="govuk-summary-list govuk-summary-list--no-border">
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Template</dt>
                                        <dd class="govuk-summary-list__value">@Model.TemplateName</dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">ID</dt>
                                        <dd class="govuk-summary-list__value"><code>@Model.TemplateId</code></dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Version</dt>
                                        <dd class="govuk-summary-list__value">
                                            <strong class="govuk-tag govuk-tag--blue">@Model.CurrentTemplateVersion</strong>
                                        </dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Description</dt>
                                        <dd class="govuk-summary-list__value">@Model.TemplateDescription</dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Task Groups</dt>
                                        <dd class="govuk-summary-list__value">@Model.TaskGroupCount</dd>
                                    </div>
                                </dl>

                                <h3 class="govuk-heading-s govuk-!-margin-top-4">Cache</h3>
                                <dl class="govuk-summary-list govuk-summary-list--no-border">
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Cache Key</dt>
                                        <dd class="govuk-summary-list__value">
                                            <code class="govuk-!-font-size-14">@Model.TemplateCacheKey</code>
                                        </dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Status</dt>
                                        <dd class="govuk-summary-list__value">
                                            @{
                                                var cacheStatus = await Model.GetCacheStatusAsync();
                                                var cacheTagClass = cacheStatus.Contains("cached") ? "govuk-tag--green" : "govuk-tag--grey";
                                            }
                                            <strong class="govuk-tag @cacheTagClass">@cacheStatus</strong>
                                        </dd>
                                    </div>
                                </dl>

                                <h3 class="govuk-heading-s govuk-!-margin-top-4">Session</h3>
                                <dl class="govuk-summary-list govuk-summary-list--no-border">
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Session Keys</dt>
                                        <dd class="govuk-summary-list__value">
                                            <code class="govuk-!-font-size-14">@Model.GetSessionKeysInfo()</code>
                                        </dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Test Token</dt>
                                        <dd class="govuk-summary-list__value">
                                            <code class="govuk-!-font-size-14">@Model.TestToken</code>
                                        </dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">DfE-SignIn Token</dt>
                                        <dd class="govuk-summary-list__value">
                                            <code class="govuk-!-font-size-14">@Model.DsiToken</code>
                                        </dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Internal User Token</dt>
                                        <dd class="govuk-summary-list__value">
                                            <code class="govuk-!-font-size-14">@Model.UserToken</code>
                                        </dd>
                                    </div>
                                </dl>
                            </div>
                        </details>
                    }
                </div>
            </div>
        }

        <div class="govuk-!-margin-top-6">
            <a href="javascript:history.back()" class="govuk-link">← Go back</a>
        </div>
    </div>
</div>
