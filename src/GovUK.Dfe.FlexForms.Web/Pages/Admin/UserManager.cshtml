@page "/admin/user-manager"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.UserManagerModel
@{
    ViewData["Title"] = "User Manager";

    static string RoleTagClass(string? role) => role?.Trim() switch
    {
        "SuperAdmin" => "govuk-tag",
        "Admin" => "govuk-tag govuk-tag--blue",
        "User" => "govuk-tag govuk-tag--grey",
        "Caseworker" => "govuk-tag govuk-tag--yellow",
        _ => "govuk-tag govuk-tag--turquoise"
    };
}

<link rel="stylesheet" href="~/css/user-manager.css" asp-append-version="true" />

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <a asp-page="/Admin/Admin" class="govuk-back-link">Back to Admin</a>

        <h1 class="govuk-heading-xl">User Manager</h1>
        <p class="govuk-body-l">
            Manage who can access forms in this tenant.
        </p>
        <div class="govuk-inset-text">
            Removing a user clears their form access for this tenant only. It does not delete their account.
        </div>

        @if (Model.HasError)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">@Model.ErrorMessage</p>
                    </div>
                </div>
            </div>
        }

        @if (Model.ShowSuccess)
        {
            <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" data-module="govuk-notification-banner">
                <div class="govuk-notification-banner__header">
                    <h2 class="govuk-notification-banner__title">Success</h2>
                </div>
                <div class="govuk-notification-banner__content">
                    <p class="govuk-notification-banner__heading">@Model.SuccessMessage</p>
                </div>
            </div>
        }

        <div class="govuk-button-group">
            <a asp-page="/Admin/UserManagerAdd" class="govuk-button" data-module="govuk-button">Add new user</a>
        </div>

        <h2 class="govuk-heading-l">
            Users (@Model.Users.Count)
        </h2>

        @if (Model.Users.Count == 0)
        {
            <p class="govuk-body">No users currently have form access in this tenant.</p>
        }
        else
        {
            <p class="govuk-hint">
                @(Model.Users.Count == 1 ? "1 person has" : $"{Model.Users.Count} people have") access in this tenant.
            </p>
            @foreach (var user in Model.Users)
            {
                var liveCount = user.Templates.Count(t => t.IsLive);
                var notLiveCount = user.Templates.Count - liveCount;

                <div class="govuk-summary-card">
                    <div class="govuk-summary-card__title-wrapper">
                        <h3 class="govuk-summary-card__title">
                            @(string.IsNullOrWhiteSpace(user.Name) ? user.Email : user.Name)
                        </h3>
                        <ul class="govuk-summary-card__actions">
                            <li class="govuk-summary-card__action">
                                <a class="govuk-link" asp-page="/Admin/UserManagerEdit" asp-route-userId="@user.UserId">
                                    Edit<span class="govuk-visually-hidden"> @(user.Name ?? user.Email)</span>
                                </a>
                            </li>
                            <li class="govuk-summary-card__action">
                                <a class="govuk-link" asp-page="/Admin/UserManagerPermissions" asp-route-userId="@user.UserId">
                                    Permissions<span class="govuk-visually-hidden"> for @(user.Name ?? user.Email)</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="govuk-summary-card__content">
                        <dl class="govuk-summary-list">
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">Email</dt>
                                <dd class="govuk-summary-list__value">
                                    <a class="govuk-link" href="mailto:@user.Email">@user.Email</a>
                                </dd>
                            </div>
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">Role</dt>
                                <dd class="govuk-summary-list__value">
                                    <strong class="@RoleTagClass(user.Role)">@(user.Role ?? "Unknown")</strong>
                                </dd>
                            </div>
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">Forms</dt>
                                <dd class="govuk-summary-list__value">
                                    @if (user.Templates.Count == 0)
                                    {
                                        <span class="govuk-hint govuk-!-margin-bottom-0">None</span>
                                    }
                                    else if (user.Templates.Count <= 3)
                                    {
                                        <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
                                            @foreach (var template in user.Templates.OrderBy(t => t.TemplateName))
                                            {
                                                <li>
                                                    @template.TemplateName
                                                    @if (template.IsLive)
                                                    {
                                                        <strong class="govuk-tag govuk-tag--green">Live</strong>
                                                    }
                                                    else
                                                    {
                                                        <strong class="govuk-tag govuk-tag--grey">Not live</strong>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="govuk-body govuk-!-margin-bottom-2">
                                            @user.Templates.Count forms
                                            @if (liveCount > 0)
                                            {
                                                <strong class="govuk-tag govuk-tag--green">@liveCount live</strong>
                                            }
                                            @if (notLiveCount > 0)
                                            {
                                                <strong class="govuk-tag govuk-tag--grey">@notLiveCount not live</strong>
                                            }
                                        </p>
                                        <details class="govuk-details govuk-!-margin-bottom-0">
                                            <summary class="govuk-details__summary">
                                                <span class="govuk-details__summary-text">Show all forms</span>
                                            </summary>
                                            <div class="govuk-details__text">
                                                <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
                                                    @foreach (var template in user.Templates.OrderBy(t => t.TemplateName))
                                                    {
                                                        <li>
                                                            @template.TemplateName
                                                            @if (template.IsLive)
                                                            {
                                                                <strong class="govuk-tag govuk-tag--green">Live</strong>
                                                            }
                                                            else
                                                            {
                                                                <strong class="govuk-tag govuk-tag--grey">Not live</strong>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </details>
                                    }
                                </dd>
                            </div>
                        </dl>

                        <form method="post"
                              asp-page-handler="Remove"
                              class="govuk-!-margin-top-4"
                              onsubmit="return confirm('Remove this user from the tenant? Their form access for this tenant will be cleared.');">
                            <input type="hidden" name="userId" value="@user.UserId" />
                            <button type="submit"
                                    class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                                    data-module="govuk-button">
                                Remove from tenant
                                <span class="govuk-visually-hidden">(@(user.Name ?? user.Email))</span>
                            </button>
                        </form>
                    </div>
                </div>
            }
        }

        <h2 class="govuk-heading-l govuk-!-margin-top-8">Access audit trail</h2>
        <p class="govuk-body">Recent role assignment and access changes in this tenant (last 50).</p>

        @if (Model.AuditLogLoadFailed)
        {
            <div class="govuk-warning-text">
                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                <strong class="govuk-warning-text__text">
                    <span class="govuk-warning-text__assistive">Warning</span>
                    @Model.AuditLogLoadErrorMessage
                </strong>
            </div>
        }
        else if (Model.AccessAuditEntries.Count == 0)
        {
            <p class="govuk-body">No access audit entries found.</p>
        }
        else
        {
            <div class="govuk-table-responsive">
                <table class="govuk-table user-manager-audit-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header user-manager-audit-table__when">When</th>
                            <th scope="col" class="govuk-table__header user-manager-audit-table__email">Subject email</th>
                            <th scope="col" class="govuk-table__header user-manager-audit-table__action">Action</th>
                            <th scope="col" class="govuk-table__header user-manager-audit-table__role">Role</th>
                            <th scope="col" class="govuk-table__header user-manager-audit-table__email">Actor email</th>
                            <th scope="col" class="govuk-table__header user-manager-audit-table__details">Details</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @foreach (var entry in Model.AccessAuditEntries)
                        {
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell user-manager-audit-table__when">@entry.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                                <td class="govuk-table__cell user-manager-audit-table__email">@entry.SubjectEmail</td>
                                <td class="govuk-table__cell user-manager-audit-table__action">
                                    <strong class="govuk-tag govuk-tag--blue">@entry.Action</strong>
                                </td>
                                <td class="govuk-table__cell user-manager-audit-table__role">@(entry.RoleName ?? "—")</td>
                                <td class="govuk-table__cell user-manager-audit-table__email">@entry.ActorEmail</td>
                                <td class="govuk-table__cell user-manager-audit-table__details">@(entry.Details ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
