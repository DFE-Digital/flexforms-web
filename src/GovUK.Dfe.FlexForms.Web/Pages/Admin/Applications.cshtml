@page "/admin/applications"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.ApplicationsModel
@{
    ViewData["Title"] = "Applications";
    var templateQuery = Model.SelectedTemplateId.HasValue
        ? $"selectedTemplateId={Model.SelectedTemplateId.Value}&"
        : string.Empty;
}

<link rel="stylesheet" href="~/css/application-listing.css" asp-append-version="true" />


<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <a asp-page="/Admin/Admin" class="govuk-back-link">Back to Admin</a>

        <h1 class="govuk-heading-xl">Applications</h1>
        <p class="govuk-body">
            Select a template to list all applications in this tenant for that template, newest first.
        </p>

        @if (Model.SuccessMessage is not null)
        {
            <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="owner-change-success-title" data-module="govuk-notification-banner">
                <div class="govuk-notification-banner__header">
                    <h2 class="govuk-notification-banner__title" id="owner-change-success-title">Success</h2>
                </div>
                <div class="govuk-notification-banner__content">
                    <p class="govuk-notification-banner__heading">@Model.SuccessMessage</p>
                </div>
            </div>
        }

        @if (Model.HasError)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">@Model.ErrorMessage</p>
                    </div>
                </div>
            </div>
        }

        <div class="govuk-form-group">
            <label class="govuk-label govuk-label--m" for="template-selector">
                Template
            </label>
            <div id="template-selector-hint" class="govuk-hint">
                Choose a template to view its applications
            </div>
            <select class="govuk-select" id="template-selector" name="selectedTemplateId"
                    aria-describedby="template-selector-hint"
                    data-navigate-param="selectedTemplateId">
                <option value="">-- Select a template --</option>
                @foreach (var template in Model.Templates)
                {
                    if (Model.SelectedTemplateId == template.TemplateId)
                    {
                        <option value="@template.TemplateId" selected>@template.Name</option>
                    }
                    else
                    {
                        <option value="@template.TemplateId">@template.Name</option>
                    }
                }
            </select>
        </div>

        @if (Model.SelectedTemplateId.HasValue)
        {
            @if (!Model.Applications.Any())
            {
                @if (!Model.HasError)
                {
                    <p class="govuk-body">No applications found for this template.</p>
                }
            }
            else
            {
                <h2 class="govuk-heading-m">Applications</h2>
                <div class="admin-application-cards">
                    @foreach (var app in Model.Applications)
                    {
                        var isDeleted = app.Status == CoreLibs.Contracts.ExternalApplications.Enums.ApplicationStatus.Deleted;
                        var leadName = app.CreatedBy?.Name;
                        var leadEmail = app.CreatedBy?.Email;
                        var hasLead = !string.IsNullOrWhiteSpace(leadName) || !string.IsNullOrWhiteSpace(leadEmail);

                        <div class="govuk-summary-card admin-application-card">
                            <div class="govuk-summary-card__title-wrapper">
                                <h3 class="govuk-summary-card__title">@app.ApplicationReference</h3>
                                <ul class="govuk-summary-card__actions">
                                    @if (isDeleted)
                                    {
                                        <li class="govuk-summary-card__action">
                                            <strong class="govuk-tag govuk-tag--red">Deleted</strong>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="govuk-summary-card__action">
                                            <a href="/applications/@app.ApplicationReference?templateId=@Model.SelectedTemplateId"
                                               class="govuk-link"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                Open<span class="govuk-visually-hidden"> @app.ApplicationReference (opens in new tab)</span>
                                            </a>
                                        </li>
                                        <li class="govuk-summary-card__action">
                                            <form method="post" class="admin-application-card__delete-form" data-confirm="Are you sure you want to delete this application?">
                                                <button type="submit" class="govuk-link admin-application-card__delete" asp-page-handler="DeleteAction"
                                                        asp-route-applicationId="@app.ApplicationId" asp-route-selectedTemplateId="@Model.SelectedTemplateId">
                                                    Delete<span class="govuk-visually-hidden"> @app.ApplicationReference</span>
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="govuk-summary-card__content">
                                <dl class="govuk-summary-list govuk-!-margin-bottom-0">
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Application ID</dt>
                                        <dd class="govuk-summary-list__value">
                                            <code class="govuk-!-font-size-16">@app.ApplicationId</code>
                                        </dd>
                                    </div>
                                    <div class="govuk-summary-list__row">
                                        <dt class="govuk-summary-list__key">Date created</dt>
                                        <dd class="govuk-summary-list__value">@app.DateCreated.ToString("d MMMM yyyy HH:mm")</dd>
                                    </div>
                                    @if (hasLead)
                                    {
                                        <div class="govuk-summary-list__row">
                                            <dt class="govuk-summary-list__key">Lead applicant</dt>
                                            <dd class="govuk-summary-list__value">
                                                @if (!string.IsNullOrWhiteSpace(leadName))
                                                {
                                                    @leadName
                                                }
                                                @if (!string.IsNullOrWhiteSpace(leadEmail))
                                                {
                                                    if (!string.IsNullOrWhiteSpace(leadName))
                                                    {
                                                        <br />
                                                    }
                                                    <a class="govuk-link" href="mailto:@leadEmail">@leadEmail</a>
                                                }
                                            </dd>
                                        </div>
                                    }
                                </dl>
                                @if (!isDeleted)
                                {
                                    <details class="govuk-details govuk-!-margin-bottom-0 govuk-!-margin-top-3">
                                        <summary class="govuk-details__summary">
                                            <span class="govuk-details__summary-text">Change lead applicant</span>
                                        </summary>
                                        <div class="govuk-details__text">
                                            <form method="post">
                                                <div class="govuk-form-group">
                                                    <label class="govuk-label" for="owner-email-@app.ApplicationId">New lead applicant email</label>
                                                    <input class="govuk-input" id="owner-email-@app.ApplicationId" name="email" type="email" autocomplete="off" spellcheck="false" />
                                                </div>
                                                <button type="submit" class="govuk-button govuk-!-margin-bottom-0" asp-page-handler="ChangeOwner"
                                                        asp-route-applicationId="@app.ApplicationId"
                                                        asp-route-selectedTemplateId="@Model.SelectedTemplateId"
                                                        asp-route-currentPage="@Model.CurrentPage">
                                                    Change lead applicant
                                                </button>
                                            </form>
                                        </div>
                                    </details>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="govuk-pagination" aria-label="Pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <div class="govuk-pagination__prev">
                            <a class="govuk-link govuk-pagination__link"
                               href="?@(templateQuery)currentPage=@(Model.CurrentPage - 1)"
                               rel="prev">
                                <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13">
                                    <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z" />
                                </svg>
                                <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                            </a>
                        </div>
                    }
                    <ul class="govuk-pagination__list">
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <li class="govuk-pagination__item govuk-pagination__item--current">
                                    <a class="govuk-link govuk-pagination__link"
                                       href="?@(templateQuery)currentPage=@i"
                                       aria-label="Page @i"
                                       aria-current="page">@i</a>
                                </li>
                            }
                            else if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.CurrentPage) <= 1)
                            {
                                <li class="govuk-pagination__item">
                                    <a class="govuk-link govuk-pagination__link"
                                       href="?@(templateQuery)currentPage=@i"
                                       aria-label="Page @i">@i</a>
                                </li>
                            }
                            else if (Math.Abs(i - Model.CurrentPage) == 2)
                            {
                                <li class="govuk-pagination__item govuk-pagination__item--ellipses">&ctdot;</li>
                            }
                        }
                    </ul>
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <div class="govuk-pagination__next">
                            <a class="govuk-link govuk-pagination__link"
                               href="?@(templateQuery)currentPage=@(Model.CurrentPage + 1)"
                               rel="next">
                                <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                                <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13">
                                    <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z" />
                                </svg>
                            </a>
                        </div>
                    }
                </nav>
            }
        }
    </div>
</div>
