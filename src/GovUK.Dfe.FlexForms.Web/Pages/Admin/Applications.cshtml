@page "/admin/applications"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.ApplicationsModel
@{
    ViewData["Title"] = "Applications";
    var templateQuery = Model.SelectedTemplateId.HasValue
        ? $"selectedTemplateId={Model.SelectedTemplateId.Value}&"
        : string.Empty;
}

<link rel="stylesheet" href="~/css/application-listing.css" asp-append-version="true" />


<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <a asp-page="/Admin/Admin" class="govuk-back-link">Back to Admin</a>

        <h1 class="govuk-heading-xl">Applications</h1>
        <p class="govuk-body">
            Select a template to list all applications in this tenant for that template, newest first.
        </p>

        @if (Model.HasError)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">@Model.ErrorMessage</p>
                    </div>
                </div>
            </div>
        }

        <div class="govuk-form-group">
            <label class="govuk-label govuk-label--m" for="template-selector">
                Template
            </label>
            <div id="template-selector-hint" class="govuk-hint">
                Choose a template to view its applications
            </div>
            <select class="govuk-select" id="template-selector" name="selectedTemplateId"
                    aria-describedby="template-selector-hint"
                    onchange="window.location.href = this.value ? ('?selectedTemplateId=' + this.value) : '?'">
                <option value="">-- Select a template --</option>
                @foreach (var template in Model.Templates)
                {
                    if (Model.SelectedTemplateId == template.TemplateId)
                    {
                        <option value="@template.TemplateId" selected>@template.Name</option>
                    }
                    else
                    {
                        <option value="@template.TemplateId">@template.Name</option>
                    }
                }
            </select>
        </div>

        @if (Model.SelectedTemplateId.HasValue && !Model.HasError)
        {
            @if (!Model.Applications.Any())
            {
                <p class="govuk-body">No applications found for this template.</p>
            }
            else
            {
                <table class="govuk-table">
                    <caption class="govuk-table__caption govuk-table__caption--m">Applications</caption>
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">Reference</th>
                            <th scope="col" class="govuk-table__header">Application ID</th>
                            <th scope="col" class="govuk-table__header">Date created</th>
                            <th scope="col" class="govuk-table__header">Action</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @foreach (var app in Model.Applications)
                        {
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">@app.ApplicationReference</td>
                                <td class="govuk-table__cell">
                                    <code class="govuk-!-font-size-14">@app.ApplicationId</code>
                                </td>
                                <td class="govuk-table__cell">@app.DateCreated.ToString("d MMMM yyyy HH:mm")</td>
                                <td class="govuk-table__cell flex">
                                    @if (app.Status == CoreLibs.Contracts.ExternalApplications.Enums.ApplicationStatus.Deleted)
                                    {
                                        <span class="govuk-tag govuk-tag--red">Deleted</span>
                                    }
                                    else
                                    {
                                        <a href="/applications/@app.ApplicationReference?templateId=@Model.SelectedTemplateId"
                                        class="govuk-link app-link"
                                        target="_blank"
                                        rel="noopener noreferrer">
                                            Open
                                            <span class="govuk-visually-hidden">@app.ApplicationReference (opens in new tab)</span>
                                        </a>                            

                                        <form id="app-delete-form" method="post" onsubmit="return confirm('Are you sure you want to delete this application?');">
                                            <button type="submit" class="govuk-link app-link-button" asp-page-handler="DeleteAction" 
                                            asp-route-applicationId="@app.ApplicationId" asp-route-selectedTemplateId="@Model.SelectedTemplateId">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="govuk-pagination" aria-label="Pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <div class="govuk-pagination__prev">
                            <a class="govuk-link govuk-pagination__link"
                               href="?@(templateQuery)currentPage=@(Model.CurrentPage - 1)"
                               rel="prev">
                                <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13">
                                    <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z" />
                                </svg>
                                <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                            </a>
                        </div>
                    }
                    <ul class="govuk-pagination__list">
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <li class="govuk-pagination__item govuk-pagination__item--current">
                                    <a class="govuk-link govuk-pagination__link"
                                       href="?@(templateQuery)currentPage=@i"
                                       aria-label="Page @i"
                                       aria-current="page">@i</a>
                                </li>
                            }
                            else if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.CurrentPage) <= 1)
                            {
                                <li class="govuk-pagination__item">
                                    <a class="govuk-link govuk-pagination__link"
                                       href="?@(templateQuery)currentPage=@i"
                                       aria-label="Page @i">@i</a>
                                </li>
                            }
                            else if (Math.Abs(i - Model.CurrentPage) == 2)
                            {
                                <li class="govuk-pagination__item govuk-pagination__item--ellipses">&ctdot;</li>
                            }
                        }
                    </ul>
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <div class="govuk-pagination__next">
                            <a class="govuk-link govuk-pagination__link"
                               href="?@(templateQuery)currentPage=@(Model.CurrentPage + 1)"
                               rel="next">
                                <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                                <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13">
                                    <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z" />
                                </svg>
                            </a>
                        </div>
                    }
                </nav>
            }
        }
    </div>
</div>
