@page "/admin/user-manager/add"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.UserManagerAddModel
@using GovUK.Dfe.FlexForms.Web.Security
@{
    ViewData["Title"] = "Add user";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <a asp-page="/Admin/UserManager" class="govuk-back-link">Back to User Manager</a>

        <govuk-error-summary>
            @foreach (var modelError in ViewData.ModelState.Where(item => item.Value?.Errors.Count > 0))
            {
                foreach (var error in modelError.Value!.Errors)
                {
                    <govuk-error-summary-item href="#">@error.ErrorMessage</govuk-error-summary-item>
                }
            }
        </govuk-error-summary>

        <h1 class="govuk-heading-xl">Add user</h1>
        <p class="govuk-body">
            Create or update a user in this tenant, assign a role, and choose which forms they can access.
        </p>

        <form method="post">
            <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.Name)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label class="govuk-label govuk-label--m" asp-for="Name">Name</label>
                @if (ViewData.ModelState[nameof(Model.Name)]?.Errors.FirstOrDefault() is { } nameError)
                {
                    <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @nameError.ErrorMessage</p>
                }
                <input class="govuk-input @(ViewData.ModelState[nameof(Model.Name)]?.Errors.Any() == true ? "govuk-input--error" : "")" asp-for="Name" />
            </div>

            <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.Email)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label class="govuk-label govuk-label--m" asp-for="Email">Email address</label>
                @if (ViewData.ModelState[nameof(Model.Email)]?.Errors.FirstOrDefault() is { } emailError)
                {
                    <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @emailError.ErrorMessage</p>
                }
                <input class="govuk-input @(ViewData.ModelState[nameof(Model.Email)]?.Errors.Any() == true ? "govuk-input--error" : "")" asp-for="Email" type="email" autocomplete="email" />
            </div>

            <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.Role)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label class="govuk-label govuk-label--m" asp-for="Role">Role</label>
                <div class="govuk-hint">
                    Includes the system User role and any custom roles from Role Manager.
                    @if (AdminAccessHelper.IsSuperAdmin(User))
                    {
                        <text> SuperAdmins can also assign the tenant Admin role.</text>
                    }
                </div>
                @if (ViewData.ModelState[nameof(Model.Role)]?.Errors.FirstOrDefault() is { } roleError)
                {
                    <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @roleError.ErrorMessage</p>
                }
                <select class="govuk-select" asp-for="Role">
                    @foreach (var role in Model.AssignableRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.SelectedTemplateIds)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Forms
                    </legend>
                    <div id="templates-hint" class="govuk-hint">
                        Required for the User role. Optional for custom roles that get Application access from Role Manager.
                    </div>
                    @if (ViewData.ModelState[nameof(Model.SelectedTemplateIds)]?.Errors.FirstOrDefault() is { } templatesError)
                    {
                        <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @templatesError.ErrorMessage</p>
                    }
                    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                        @if (Model.AvailableTemplates.Count == 0)
                        {
                            <p class="govuk-body">No forms are available in this tenant.</p>
                        }
                        else
                        {
                            @foreach (var template in Model.AvailableTemplates)
                            {
                                var isChecked = Model.SelectedTemplateIds.Contains(template.TemplateId);
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input"
                                           id="template-@template.TemplateId"
                                           name="SelectedTemplateIds"
                                           type="checkbox"
                                           value="@template.TemplateId"
                                           @(isChecked ? "checked" : null) />
                                    <label class="govuk-label govuk-checkboxes__label" for="template-@template.TemplateId">
                                        @template.Name
                                        @if (template.IsLive)
                                        {
                                            <strong class="govuk-tag govuk-tag--green govuk-!-margin-left-1">Live</strong>
                                        }
                                        else
                                        {
                                            <strong class="govuk-tag govuk-tag--grey govuk-!-margin-left-1">Not live</strong>
                                        }
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </fieldset>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Add user</button>
                <a asp-page="/Admin/UserManager" class="govuk-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
