@page "/admin/custom-status-label-overrides"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.CustomStatusLabelOverridesModel
@{
    ViewData["Title"] = "Admin - Custom Status Overrides";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl">@ViewData["Title"]</h1>
        @if (Model.ShowSuccess)
        {
            <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
                <div class="govuk-notification-banner__header">
                    <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                        Success
                    </h2>
                </div>
                <div class="govuk-notification-banner__content">
                    <h3 class="govuk-notification-banner__heading">
                        The custom application statuses have been updated successfully
                    </h3>
                    <p class="govuk-body">
                        <strong>The cache has been refreshed and these statuses will take effect immediately</strong>
                    </p>
                </div>
            </div>
        }
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Template ID
                </dt>
                <dd class="govuk-summary-list__value">
                    @Model.CurrentTemplate?.TemplateId
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Template Name
                </dt>
                <dd class="govuk-summary-list__value">
                    @Model.CurrentTemplate?.TemplateName
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Current Version
                </dt>
                <dd class="govuk-summary-list__value">
                    @Model.CurrentVersionNumber
                </dd>
            </div>
        </dl>
        <form method="post" novalidate="">
            <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="base-status">
                    Base Status
                </label>
                <select class="govuk-select" id="base-status" asp-for="SelectedBaseStatus" onchange="this.form.submit()">
                    @foreach(var status in Model.BaseStatuses)
                    {
                        <option value="@status.Key">@status.Value</option>
                    }
                </select>
            </div>
            <div class="govuk-form-group ">
                <label class="govuk-label govuk-label--m" for="BaseStatusOverrideValue">
                    Custom Status Value
                </label>
                @if (ViewData.ModelState["BaseStatusOverrideValue"]?.Errors.Any() == true)
                {
                    <p id="version-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> @ViewData.ModelState["BaseStatusOverrideValue"]?.Errors.First().ErrorMessage
                    </p>
                }
                <input class="govuk-input govuk-input @(ViewData.ModelState["BaseStatusOverrideValue"]?.Errors.Any() == true ? "govuk-input--error" : "")"
                       asp-for="BaseStatusOverrideValue" type="text" />
            </div>

            <div class="govuk-button-group">
                <button class="govuk-button" type="submit" id="save-new-version-button">Save Overrides</button>
                <button class="govuk-button govuk-button--secondary" type="submit" id="cancel-add-version-button" asp-page-handler="CancelOverride">Cancel</button>
            </div>
        </form>

        <!-- Navigation -->
        <div class="govuk-!-margin-top-6">
            <a href="javascript:history.back()" class="govuk-link">← Go back</a>
        </div>
    </div>
</div> 