@page "/admin/template-editor"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.TemplateEditorModel
@{
    ViewData["Title"] = "Template editor";
    bool HasError(string key) => ViewData.ModelState[key]?.Errors.Any() == true;
}

<link rel="stylesheet" href="~/css/template-editor.css" asp-append-version="true" />

<a asp-page="/Admin/TemplateManager" class="govuk-back-link">Back to Template Manager</a>

@if (Model.SavedVersion is not null)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="template-editor-saved-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="template-editor-saved-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">Version @Model.SavedVersion saved</h3>
            <p class="govuk-body">New applications will use this version. You can keep editing and save another version.</p>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <govuk-error-summary>
        @foreach (var entry in ViewData.ModelState.Where(item => item.Value?.Errors.Count > 0))
        {
            var href = entry.Key switch
            {
                nameof(Model.NewVersion) => "#NewVersion",
                nameof(Model.AcknowledgeReportingImpact) => "#AcknowledgeReportingImpact",
                _ => "#template-editor-tabs"
            };
            foreach (var error in entry.Value!.Errors)
            {
                <govuk-error-summary-item href="@href">@error.ErrorMessage</govuk-error-summary-item>
            }
        }
    </govuk-error-summary>
}

@if (Model.LoadError is not null)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <p class="govuk-body">@Model.LoadError</p>
                <p class="govuk-body">The editor won't open until the template loads, so a saved version can't be replaced by mistake.</p>
            </div>
        </div>
    </div>
    return;
}

<span class="govuk-caption-l">Template editor</span>
<h1 class="govuk-heading-l govuk-!-margin-bottom-2">@Model.SelectedTemplate!.Name</h1>
<p class="govuk-body govuk-!-margin-bottom-6">
    @if (Model.SelectedTemplate.IsLive)
    {
        <strong class="govuk-tag govuk-tag--green">Live</strong>
    }
    else
    {
        <strong class="govuk-tag govuk-tag--grey">Not live</strong>
    }
    @if (Model.CurrentVersionNumber is not null)
    {
        var latestSuffix = string.Equals(Model.CurrentVersionNumber, Model.LatestVersionNumber, StringComparison.OrdinalIgnoreCase) ? " (latest)" : "";
        <span class="govuk-!-margin-left-2">Editing a copy of version @(Model.CurrentVersionNumber + latestSuffix)</span>
    }
    else
    {
        <span class="govuk-!-margin-left-2">No versions yet. You're starting from the starter template.</span>
    }
</p>

<noscript>
    <div class="govuk-inset-text">
        The visual editor needs JavaScript. You can still edit the JSON in <a asp-page="/Admin/TemplateManager" class="govuk-link">Template Manager</a>.
    </div>
</noscript>

<div id="template-editor" class="tpl-editor" hidden>
    <div class="tpl-editor__toolbar">
        <p class="govuk-body govuk-!-margin-bottom-0 tpl-editor__status" id="tpl-status" role="status" aria-live="polite">No unsaved changes</p>
        <div class="govuk-button-group govuk-!-margin-bottom-0">
            <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" id="tpl-check-button">Check for problems</button>
            <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" id="tpl-preview-button">Preview task</button>
            <a href="#tpl-save" class="govuk-button govuk-!-margin-bottom-0" id="tpl-go-to-save">Save new version</a>
        </div>
    </div>

    <div id="tpl-problems" class="govuk-!-margin-top-4" tabindex="-1"></div>

    <div class="govuk-tabs tpl-editor__tabs" id="template-editor-tabs">
        <ul class="govuk-tabs__list" role="tablist">
            <li class="govuk-tabs__list-item govuk-tabs__list-item--selected" role="presentation">
                <a class="govuk-tabs__tab" href="#tpl-panel-design" role="tab" id="tpl-tab-design" aria-controls="tpl-panel-design" aria-selected="true" data-tpl-tab="design">Design</a>
            </li>
            <li class="govuk-tabs__list-item" role="presentation">
                <a class="govuk-tabs__tab" href="#tpl-panel-rules" role="tab" id="tpl-tab-rules" aria-controls="tpl-panel-rules" aria-selected="false" tabindex="-1" data-tpl-tab="rules">Rules</a>
            </li>
            <li class="govuk-tabs__list-item" role="presentation">
                <a class="govuk-tabs__tab" href="#tpl-panel-json" role="tab" id="tpl-tab-json" aria-controls="tpl-panel-json" aria-selected="false" tabindex="-1" data-tpl-tab="json">JSON (advanced)</a>
            </li>
        </ul>

        <section class="govuk-tabs__panel" id="tpl-panel-design" role="tabpanel" aria-labelledby="tpl-tab-design">
            <div class="tpl-editor__design">
                <nav class="tpl-editor__tree" id="tpl-tree" aria-label="Template structure"></nav>
                <div class="tpl-editor__inspector" id="tpl-inspector"></div>
            </div>
        </section>

        <section class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tpl-panel-rules" role="tabpanel" aria-labelledby="tpl-tab-rules">
            <div id="tpl-rules"></div>
        </section>

        <section class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tpl-panel-json" role="tabpanel" aria-labelledby="tpl-tab-json">
            <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="tpl-json">Template JSON</label>
                <div class="govuk-hint" id="tpl-json-hint">
                    This is the JSON the editor generates. Changes you make here are applied when you leave this tab, check for problems, preview or save.
                </div>
                <p class="govuk-error-message" id="tpl-json-error" hidden></p>
                <textarea class="govuk-textarea tpl-editor__json" id="tpl-json" rows="30" spellcheck="false" aria-describedby="tpl-json-hint tpl-json-error"></textarea>
            </div>
            <button type="button" class="govuk-button govuk-button--secondary" id="tpl-json-format">Format JSON</button>
        </section>
    </div>

    <h2 class="govuk-heading-l govuk-!-margin-top-8" id="tpl-save" tabindex="-1">Save a new version</h2>
    <form method="post" asp-page-handler="Save" id="tpl-save-form">
        <input type="hidden" asp-for="NewSchema" id="NewSchema" />

        <div class="govuk-form-group @(HasError(nameof(Model.NewVersion)) ? "govuk-form-group--error" : "")">
            <label class="govuk-label govuk-label--s" asp-for="NewVersion">Version number</label>
            <div id="NewVersion-hint" class="govuk-hint">Three numbers separated by full stops, for example 1.2.1. Each version number can only be used once.</div>
            @if (ViewData.ModelState[nameof(Model.NewVersion)]?.Errors.FirstOrDefault() is { } versionError)
            {
                <p id="NewVersion-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @versionError.ErrorMessage</p>
            }
            <input class="govuk-input govuk-input--width-10 @(HasError(nameof(Model.NewVersion)) ? "govuk-input--error" : "")"
                   asp-for="NewVersion" type="text" spellcheck="false"
                   aria-describedby="NewVersion-hint @(HasError(nameof(Model.NewVersion)) ? "NewVersion-error" : "")" />
        </div>

        <div class="govuk-form-group @(HasError(nameof(Model.AcknowledgeReportingImpact)) ? "govuk-form-group--error" : "")">
            <div class="govuk-warning-text">
                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                <strong class="govuk-warning-text__text">
                    <span class="govuk-visually-hidden">Warning</span>
                    Changing a template can break reporting in downstream services, or leave answers out of reported data. Discuss changes with the relevant data team before you save.
                </strong>
            </div>
            @if (ViewData.ModelState[nameof(Model.AcknowledgeReportingImpact)]?.Errors.FirstOrDefault() is { } acknowledgeError)
            {
                <p id="AcknowledgeReportingImpact-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @acknowledgeError.ErrorMessage</p>
            }
            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                <div class="govuk-checkboxes__item">
                    <input class="govuk-checkboxes__input" asp-for="AcknowledgeReportingImpact" type="checkbox"
                           aria-describedby="@(HasError(nameof(Model.AcknowledgeReportingImpact)) ? "AcknowledgeReportingImpact-error" : null)" />
                    <label class="govuk-label govuk-checkboxes__label" asp-for="AcknowledgeReportingImpact">
                        I have discussed these changes with the relevant data team
                    </label>
                </div>
            </div>
        </div>

        <button type="submit" class="govuk-button" id="tpl-save-button">Save new version</button>
    </form>

    <form method="post" asp-page="/Admin/TemplateEditorPreview" target="_blank" id="tpl-preview-form" hidden>
        <input type="hidden" name="Schema" id="tpl-preview-schema" />
        <input type="hidden" name="TaskId" id="tpl-preview-task" />
    </form>
</div>

<script type="application/json" id="template-editor-data">@Html.Raw(Model.EditorDataJson)</script>

@section Scripts {
    <script src="~/js/template-editor/template-document.js" asp-append-version="true"></script>
    <script src="~/js/template-editor/template-editor.js" asp-append-version="true"></script>
}
