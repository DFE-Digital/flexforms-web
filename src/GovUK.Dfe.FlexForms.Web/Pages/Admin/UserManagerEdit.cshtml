@page "/admin/user-manager/edit"
@model GovUK.Dfe.FlexForms.Web.Pages.Admin.UserManagerEditModel
@using GovUK.Dfe.FlexForms.Web.Security
@inject Microsoft.Extensions.Options.IOptions<GovUK.Dfe.CoreLibs.Security.Configurations.TestAuthenticationOptions> TestAuthOptions
@inject Microsoft.Extensions.Options.IOptions<GovUK.Dfe.CoreLibs.Security.Configurations.EntraSsoOptions> EntraSsoOptions
@{
    ViewData["Title"] = "Edit user";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <a asp-page="/Admin/UserManager" class="govuk-back-link">Back to User Manager</a>

        <govuk-error-summary>
            @foreach (var modelError in ViewData.ModelState.Where(item => item.Value?.Errors.Count > 0))
            {
                foreach (var error in modelError.Value!.Errors)
                {
                    <govuk-error-summary-item href="#">@error.ErrorMessage</govuk-error-summary-item>
                }
            }
        </govuk-error-summary>

        <h1 class="govuk-heading-xl">Edit user</h1>

        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Name</dt>
                <dd class="govuk-summary-list__value">@Model.UserName</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Email</dt>
                <dd class="govuk-summary-list__value">@Model.UserEmail</dd>
            </div>
        </dl>

        @if (TenantAuthSchemeSelector.IsTestAuthenticationActive(ViewContext.HttpContext, TestAuthOptions, EntraSsoOptions))
        {
            <p class="govuk-body">
                <a asp-page="/Admin/UserManagerAuthenticatorCode" asp-route-email="@Model.UserEmail" class="govuk-link" id="user-manager-edit-authenticator-code">
                    Create an authenticator app setup code for this user
                </a>
            </p>
        }

        @if (Model.SignInLock is { } signInLock)
        {
            <h2 class="govuk-heading-m" id="sign-in-lock">Sign-in lock</h2>

            @if (Model.SignInLockSuccessMessage is { } lockSuccess)
            {
                <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" data-module="govuk-notification-banner" id="user-manager-edit-sign-in-lock-success">
                    <div class="govuk-notification-banner__header">
                        <h3 class="govuk-notification-banner__title">Success</h3>
                    </div>
                    <div class="govuk-notification-banner__content">
                        <p class="govuk-notification-banner__heading">@lockSuccess</p>
                    </div>
                </div>
            }

            @if (Model.SignInLockErrorMessage is { } lockError)
            {
                <div class="govuk-error-summary" data-module="govuk-error-summary" id="user-manager-edit-sign-in-lock-error">
                    <div role="alert">
                        <h3 class="govuk-error-summary__title">There is a problem</h3>
                        <div class="govuk-error-summary__body">
                            <p class="govuk-body">@lockError</p>
                        </div>
                    </div>
                </div>
            }

            @if (signInLock.IsLoaded)
            {
                <dl class="govuk-summary-list">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Status</dt>
                        <dd class="govuk-summary-list__value" id="user-manager-edit-sign-in-lock-status">
                            @if (signInLock.IsManuallyLocked)
                            {
                                <strong class="govuk-tag govuk-tag--red">Locked by an administrator</strong>
                                <p class="govuk-body govuk-!-margin-top-2 govuk-!-margin-bottom-0">
                                    Locked
                                    @if (signInLock.LockedAtUtc is { } lockedAt)
                                    {
                                        <text> on @lockedAt.ToString("d MMMM yyyy 'at' HH:mm 'UTC'")</text>
                                    }
                                    @if (!string.IsNullOrEmpty(signInLock.LockedByEmail))
                                    {
                                        <text> by @signInLock.LockedByEmail</text>
                                    }
                                </p>
                            }
                            else if (signInLock.IsTemporarilyLocked)
                            {
                                <strong class="govuk-tag govuk-tag--orange">Temporarily locked</strong>
                                <p class="govuk-body govuk-!-margin-top-2 govuk-!-margin-bottom-0">
                                    Too many incorrect authenticator app codes. Unlocks automatically in
                                    @GovUK.Dfe.FlexForms.Application.Admin.TestAuthSignInLockMessages.TemporarilyLockedFor(signInLock.RetryAfterSeconds).
                                </p>
                            }
                            else
                            {
                                <strong class="govuk-tag govuk-tag--green">Not locked</strong>
                            }
                        </dd>
                        @if (signInLock.IsTemporarilyLocked)
                        {
                            <dd class="govuk-summary-list__actions">
                                <form method="post" asp-page-handler="ClearTemporaryLockout" class="govuk-!-margin-0">
                                    <input type="hidden" asp-for="UserId" />
                                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" id="user-manager-edit-unlock-now">
                                        Unlock now<span class="govuk-visually-hidden"> temporary lock</span>
                                    </button>
                                </form>
                            </dd>
                        }
                    </div>
                </dl>

                <form method="post" asp-page-handler="SignInLock">
                    <input type="hidden" asp-for="UserId" />
                    <div class="govuk-form-group">
                        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" id="LockSignIn" name="LockSignIn" type="checkbox" value="true"
                                       aria-describedby="LockSignIn-hint" @(Model.LockSignIn ? "checked" : null) />
                                <label class="govuk-label govuk-checkboxes__label" for="LockSignIn">
                                    Lock this user out of sign-in
                                </label>
                                <div id="LockSignIn-hint" class="govuk-hint govuk-checkboxes__hint">
                                    Blocks every sign-in method, including one-time passwords by email. The lock does not
                                    expire. The user is told to contact a tenant administrator. Untick to unlock them, which
                                    also removes any temporary lock.
                                </div>
                            </div>
                        </div>
                        <input type="hidden" name="LockSignIn" value="false" />
                    </div>
                    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button" id="user-manager-edit-save-sign-in-lock">
                        Save sign-in lock
                    </button>
                </form>
            }

            <h2 class="govuk-heading-m">Role and form access</h2>
        }

        <form method="post">
            <input type="hidden" asp-for="UserId" />

            <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.Role)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label class="govuk-label govuk-label--m" asp-for="Role">Role</label>
                <div class="govuk-hint">
                    Roles are managed in Role Manager. Create a custom role there before assigning it.
                    @if (AdminAccessHelper.IsSuperAdmin(User))
                    {
                        <text> SuperAdmins can also assign the tenant Admin role.</text>
                    }
                </div>
                @if (ViewData.ModelState[nameof(Model.Role)]?.Errors.FirstOrDefault() is { } roleError)
                {
                    <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @roleError.ErrorMessage</p>
                }
                <select class="govuk-select" asp-for="Role">
                    @foreach (var role in Model.AssignableRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Forms this user can access
                    </legend>
                    <div class="govuk-hint">
                        Optional for custom roles that already grant Application access via Role Manager.
                    </div>
                    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                        @if (Model.AvailableTemplates.Count == 0)
                        {
                            <p class="govuk-body">No forms are available in this tenant.</p>
                        }
                        else
                        {
                            @foreach (var template in Model.AvailableTemplates)
                            {
                                var isChecked = Model.SelectedTemplateIds.Contains(template.TemplateId);
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input"
                                           id="template-@template.TemplateId"
                                           name="SelectedTemplateIds"
                                           type="checkbox"
                                           value="@template.TemplateId"
                                           @(isChecked ? "checked" : null) />
                                    <label class="govuk-label govuk-checkboxes__label" for="template-@template.TemplateId">
                                        @template.Name
                                        @if (template.IsLive)
                                        {
                                            <strong class="govuk-tag govuk-tag--green govuk-!-margin-left-1">Live</strong>
                                        }
                                        else
                                        {
                                            <strong class="govuk-tag govuk-tag--grey govuk-!-margin-left-1">Not live</strong>
                                        }
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </fieldset>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
                <a asp-page="/Admin/UserManager" class="govuk-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
