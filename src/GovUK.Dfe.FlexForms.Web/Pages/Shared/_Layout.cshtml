@* Application Insights JavaScript for client-side user tracking - respects cookie consent *@
@{
    var cookiesAccepted = Context.Request.Cookies[".AspNet.Consent"] == "yes";
}
@if (cookiesAccepted)
{
    @Html.Raw(JavaScriptSnippet.FullScript)
}

@await Html.PartialAsync("_NotificationDisplay")

@RenderBody()

@await Component.InvokeAsync("SessionTimeoutBanner")

@* Provide a stable anti-forgery token element in the body for JS to read *@
<form id="__af" method="post" style="display:none">@Html.AntiForgeryToken()</form>

@* SignalR library *@
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8/dist/browser/signalr.min.js" defer></script>
<script src="~/js/hub-auth.js" defer></script>
<script src="~/js/notifications.js" defer></script>

@RenderSection("Scripts", required: false)

@* Add accessible-autocomplete library *@
<script src="https://cdn.jsdelivr.net/npm/accessible-autocomplete@2.0.4/dist/accessible-autocomplete.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/accessible-autocomplete@2.0.4/dist/accessible-autocomplete.min.css" />

<style>
    .govuk-hint.hint--default {
        color: var(--govuk-text-colour); /* black/default text colour */
    }

    .app-notification-banner {
        display: block;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        align-self: stretch;
    }
</style>