@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication
@using System.IdentityModel.Tokens.Jwt
@using GovUK.Dfe.FlexForms.Web.Tenancy
@inject IAuthorizationService AuthService
@inject Microsoft.ApplicationInsights.AspNetCore.JavaScriptSnippet JavaScriptSnippet
@inject ITenantAppConfiguration AppConfig
@inject GovUK.Dfe.FlexForms.Web.Services.ITemplateSelectionService TemplateSelectionService

@{
    Layout = "_GovUkPageTemplate";
}
@{
    var apiBase = (AppConfig["ExternalApplicationsApiClient:BaseUrl"] ?? "").TrimEnd('/');
}
<meta name="api-base" content="@apiBase" />
@section Header {
    @{
        var currentEnvironment = ViewContext.HttpContext.RequestServices.GetService<IWebHostEnvironment>()?.EnvironmentName ?? "Unknown";
        
        // Get token expiry info for development
        string tokenInfo = "";
        bool isTokenExpiringSoon = false;
        if (!currentEnvironment.Equals("Prod", StringComparison.OrdinalIgnoreCase) && User?.Identity?.IsAuthenticated == true)
        {
            try
            {
                // First try to get expiry from authentication properties
                var authResult = await ViewContext.HttpContext.AuthenticateAsync();
                DateTimeOffset? expiryTime = null;
                
                if (authResult.Succeeded && authResult.Properties?.ExpiresUtc.HasValue == true)
                {
                    expiryTime = authResult.Properties.ExpiresUtc.Value;
                }
                else
                {
                    // Try to get the access token and decode it directly
                    string accessToken = null;
                    
                    // Try to get token from different possible locations
                    if (authResult.Succeeded && authResult.Properties?.GetTokenValue("access_token") != null)
                    {
                        accessToken = authResult.Properties.GetTokenValue("access_token");
                    }
                    else if (ViewContext.HttpContext.Session.GetString("access_token") != null)
                    {
                        accessToken = ViewContext.HttpContext.Session.GetString("access_token");
                    }
                    
                    if (!string.IsNullOrEmpty(accessToken))
                    {
                        try
                        {
                            var tokenHandler = new JwtSecurityTokenHandler();
                            if (tokenHandler.CanReadToken(accessToken))
                            {
                                var jsonToken = tokenHandler.ReadJwtToken(accessToken);
                                
                                // Get the exp claim from the JWT payload
                                var expClaim = jsonToken.Claims.FirstOrDefault(c => c.Type == "exp");
                                if (expClaim != null && long.TryParse(expClaim.Value, out var exp))
                                {
                                    expiryTime = DateTimeOffset.FromUnixTimeSeconds(exp);
                                }
                                else
                                {
                                    tokenInfo = " | ⚠️ No exp claim found in token";
                                }
                            }
                            else
                            {
                                tokenInfo = " | ⚠️ Invalid JWT token format";
                            }
                        }
                        catch (Exception ex)
                        {
                            tokenInfo = $" | ⚠️ Error reading token: {ex.Message}";
                        }
                    }
                    else
                    {
                        tokenInfo = " | ⚠️ No access token found";
                    }
                }
                
                if (expiryTime.HasValue)
                {
                    var timeLeft = expiryTime.Value - DateTimeOffset.UtcNow;
                    var totalMinutes = (int)timeLeft.TotalMinutes-5;
                    
                    if (totalMinutes <= 0)
                    {
                        tokenInfo = " | ⚠️ TOKEN EXPIRED - Please log out and sign in again";
                        isTokenExpiringSoon = true;
                    }
                    else if (totalMinutes <= 10)
                    {
                        tokenInfo = $" | ⚠️ TOKEN EXPIRES IN: {totalMinutes}m {timeLeft.Seconds}s - Consider refreshing";
                        isTokenExpiringSoon = true;
                    }
                    else
                    {
                        tokenInfo = $" | Token expires in: {totalMinutes}m";
                    }
                }
                else
                {
                    tokenInfo = " | ⚠️ Token expiry unavailable";
                }
            }
            catch 
            {
                tokenInfo = " | ⚠️ Token info unavailable";
                isTokenExpiringSoon = true;
            }
        }
        
        // Determine banner color based on token status
        var bannerColor = isTokenExpiringSoon ? "#f47738" : "#FFE3AA";
        var textColor = isTokenExpiringSoon ? "white" : "black";
        var isTemplatePreview =
            Context.Request.Path.StartsWithSegments("/applications", StringComparison.OrdinalIgnoreCase) &&
            TemplateSelectionService.IsPreviewSelection(Context);
        var previewTemplateName = TemplateSelectionService.GetSelectedTemplateName(Context);

        var showFormsNav = false;
        if (User?.Identity?.IsAuthenticated == true
            && !GovUK.Dfe.FlexForms.Web.Security.AuthenticationPathExclusions.ShouldSkip(Context.Request.Path))
        {
            if (GovUK.Dfe.FlexForms.Web.Security.AdminAccessHelper.CanManageTemplates(User))
            {
                showFormsNav = true;
            }
            else
            {
                try
                {
                    var selectableForms = await TemplateSelectionService.GetSelectableTemplatesAsync();
                    showFormsNav = selectableForms.Count(form => form.IsLive) > 1;
                }
                catch
                {
                    showFormsNav = false;
                }
            }
        }
    }
    @if (isTemplatePreview && !string.IsNullOrWhiteSpace(previewTemplateName))
    {
        <div class="environment-banner govuk-link govuk-link--no-underline govuk-!-font-weight-regular govuk-!-font-size-19"
             style="background-color: #f47738; color: white; text-align: left; padding: 8px;">
            <div class="govuk-width-container">
                THIS IS A PREVIEW OF @previewTemplateName
            </div>
        </div>
    }

    @if (!currentEnvironment.Equals("Production", StringComparison.OrdinalIgnoreCase))
    {
        <div class="environment-banner govuk-link govuk-link--no-underline govuk-!-font-weight-regular govuk-!-font-size-19" style="background-color: @bannerColor; color: @textColor; text-align: left; padding: 8px;">
            <div class="govuk-width-container">
                 @(currentEnvironment.ToUpper()) ENVIRONMENT@(tokenInfo)
            </div>
        </div>
    }

    @if (Context.Session.GetString("CookieBannerHidden") != "1")
    {
        <partial name="_CookiesBanner" />
    }

    <govuk-header home-page-url="/"></govuk-header>
    <section aria-label="Service information" class="govuk-service-navigation"
             data-module="govuk-service-navigation">
        <div class="govuk-width-container">
            <div class="govuk-service-navigation__container app-service-nav-container">
                <span class="govuk-service-navigation__service-name">
                    <a class="govuk-service-navigation__link" href="/applications/dashboard">
                        @AppConfig["Layout:ServiceName"]
                    </a>
                </span>
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <nav aria-label="Menu" class="govuk-service-navigation__wrapper app-service-nav-right">
                        <button type="button" class="govuk-service-navigation__toggle govuk-js-service-navigation-toggle" aria-controls="navigation" hidden>
                            Menu
                        </button>
                        <ul class="govuk-service-navigation__list" id="navigation">
                            @if (GovUK.Dfe.FlexForms.Web.Security.AdminAccessHelper.CanReadAnyApplication(User))
                            {
                                <li class="govuk-service-navigation__item">
                                    <a class="govuk-service-navigation__link" href="/applications">
                                        Applications
                                    </a>
                                </li>
                            }
                            @if (showFormsNav)
                            {
                                <li class="govuk-service-navigation__item">
                                    <a class="govuk-service-navigation__link" href="/templates">
                                        Forms
                                    </a>
                                </li>
                            }
                            @if (GovUK.Dfe.FlexForms.Web.Security.AdminAccessHelper.CanAccessAdminArea(User))
                            {
                                <li class="govuk-service-navigation__item">
                                    <a class="govuk-service-navigation__link app-badge-container" href="/admin" style="position: relative;">
                                        Admin
                                    </a>
                                </li>
                            }
                            <li class="govuk-service-navigation__item">
                                <a class="govuk-service-navigation__link app-badge-container" href="/Notifications" style="position: relative;">
                                    Notifications
                                    <span id="notifications-unread-sr" class="govuk-visually-hidden"></span>
                                    <span id="notifications-unread-badge" class="app-notifications-badge" aria-hidden="true"></span>
                                </a>
                            </li>
                            <li class="govuk-service-navigation__item">
                                <a class="govuk-service-navigation__link" href="/Logout">Log out</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </section>
    <div class="govuk-width-container app-width-container">
        <div class="govuk-phase-banner">
            <p class="govuk-phase-banner__content">
                <strong class="govuk-tag govuk-phase-banner__content__tag">
                    @AppConfig["Layout:PhaseBanner:PhaseText"]
                </strong>
                @foreach (var link in AppConfig.GetSection("Layout:PhaseBanner:Links").GetChildren().Take(2))
                {
                    <span class="govuk-phase-banner__text">
                        @try
                        {
                            var referenceNumber = Model.ReferenceNumber;
                            <a class="govuk-link" asp-page="@link["Url"]" asp-route-referenceNumber="@referenceNumber" target="_blank" rel="noreferrer">
                                @link["Text"]
                            </a>
                        }
                        catch
                        {
                            <a class="govuk-link" asp-page="@link["Url"]" target="_blank" rel="noreferrer">
                                @link["Text"]
                            </a>
                        }
                    </span>
                }
            </p>
        </div>
    </div>
}
@section BeforeContent {
    @await Component.InvokeAsync("NotificationBanner")
    @RenderSection("BeforeContent", required: false)
}
@{
    var returnPath = Context.Request.Path;
}
