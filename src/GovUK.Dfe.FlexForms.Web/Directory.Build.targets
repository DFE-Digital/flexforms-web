<Project>
  <PropertyGroup>
    <ParentDirectoryBuildTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)..'))</ParentDirectoryBuildTargets>
  </PropertyGroup>
  <Import Project="$(ParentDirectoryBuildTargets)"
          Condition="'$(ParentDirectoryBuildTargets)' != ''" />
  <Import Project="Directory.Build.targets.user"
          Condition="Exists('Directory.Build.targets.user')" />
</Project>
