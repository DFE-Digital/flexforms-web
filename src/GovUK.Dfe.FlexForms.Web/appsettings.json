{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "DfE.ExternalApplications": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "ApplicationInsights": {
    "ConnectionString": "localhost:6379"
  },
  "InternalServiceAuth": {
    "Services": [
      {
        "Email": "eat-transfer-service@service.com",
        "ApiKey": "secret"
      },
      {
        "Email": "eat-cypress-service@service.com",
        "ApiKey": "secret"
      }
    ],
    "SecretKey": "secret",
    "Issuer": "external-applications-web",
    "Audience": "external-applications-api",
    "TokenLifetimeMinutes": 10
  },

  "CacheSettings": {
    "Memory": {
      "DefaultDurationInSeconds": 60,
      "Durations": {
        "GetTemplateAsync": 86400
      }
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "DefaultDurationInSeconds": 300,
      "KeyPrefix": "FlexForms:Cache:",
      "Database": 0,
      "Durations": {}
    }
  },
  "TestAuthentication": {
    "Enabled": false,
    "JwtSigningKey": "",
    "JwtIssuer": "test-external-applications",
    "JwtAudience": "external-applications-api"
  },
  "EventMappings": {
    "BasePath": "EventMappings"
  }
}
